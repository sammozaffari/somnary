{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/chrome/**",
              "components/evidence/**",
              "components/verdicts/**",
              "ds-loader.js",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Onest))/i]",
        "message": "Font not provided by the design system. Available: Onest."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|radius|style|key|ref|className|style|children)$/]",
        "message": "<BrandMark> doesn't accept that prop. Declared props: name, src, size, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandResultRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|image|productCount|buckets|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<BrandResultRow> doesn't accept that prop. Declared props: name, image, productCount, buckets, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BucketBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:bucket|naming|sentence|compact|style|key|ref|className|style|children)$/]",
        "message": "<BucketBadge> doesn't accept that prop. Declared props: bucket, naming, sentence, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BucketBadge'] > JSXAttribute[name.name='bucket'] > Literal[value!=/^(?:works|maybe|unknown|avoid)$/]",
        "message": "<BucketBadge> bucket must be one of 'works' | 'maybe' | 'unknown' | 'avoid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BucketBadge'] > JSXAttribute[name.name='naming'] > Literal[value!=/^(?:plain|evidence)$/]",
        "message": "<BucketBadge> naming must be one of 'plain' | 'evidence'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BucketShape'] > JSXAttribute > JSXIdentifier[name!=/^(?:bucket|size|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<BucketShape> doesn't accept that prop. Declared props: bucket, size, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BucketShape'] > JSXAttribute[name.name='bucket'] > Literal[value!=/^(?:works|maybe|unknown|avoid)$/]",
        "message": "<BucketShape> bucket must be one of 'works' | 'maybe' | 'unknown' | 'avoid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LabelVsStudies'] > JSXAttribute > JSXIdentifier[name!=/^(?:claim|found|chip|animate|delay|style|key|ref|className|style|children)$/]",
        "message": "<LabelVsStudies> doesn't accept that prop. Declared props: claim, found, chip, animate, delay, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PairedVerdict'] > JSXAttribute > JSXIdentifier[name!=/^(?:bucket|criteria|ingredientName|productName|naming|bucketSentence|style|key|ref|className|style|children)$/]",
        "message": "<PairedVerdict> doesn't accept that prop. Declared props: bucket, criteria, ingredientName, productName, naming, bucketSentence, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PairedVerdict'] > JSXAttribute[name.name='bucket'] > Literal[value!=/^(?:works|maybe|unknown|avoid)$/]",
        "message": "<PairedVerdict> bucket must be one of 'works' | 'maybe' | 'unknown' | 'avoid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PairedVerdict'] > JSXAttribute[name.name='naming'] > Literal[value!=/^(?:plain|evidence)$/]",
        "message": "<PairedVerdict> naming must be one of 'plain' | 'evidence'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlainStat'] > JSXAttribute > JSXIdentifier[name!=/^(?:figure|text|source|chip|size|style|key|ref|className|style|children)$/]",
        "message": "<PlainStat> doesn't accept that prop. Declared props: figure, text, source, chip, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlainStat'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<PlainStat> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|brand|strength|blend|image|state|bucket|criteria|lastChecked|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: name, brand, strength, blend, image, state, bucket, criteria, lastChecked, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:assessed|labelOnly|notFound)$/]",
        "message": "<ProductCard> state must be one of 'assessed' | 'labelOnly' | 'notFound'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute[name.name='bucket'] > Literal[value!=/^(?:works|maybe|unknown|avoid)$/]",
        "message": "<ProductCard> bucket must be one of 'works' | 'maybe' | 'unknown' | 'avoid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductScoreBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:criteria|showBreakdown|style|key|ref|className|style|children)$/]",
        "message": "<ProductScoreBadge> doesn't accept that prop. Declared props: criteria, showBreakdown, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RemedyCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|bucket|naming|sentence|research|safetyFlag|meta|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<RemedyCard> doesn't accept that prop. Declared props: name, bucket, naming, sentence, research, safetyFlag, meta, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RemedyCard'] > JSXAttribute[name.name='bucket'] > Literal[value!=/^(?:works|maybe|unknown|avoid)$/]",
        "message": "<RemedyCard> bucket must be one of 'works' | 'maybe' | 'unknown' | 'avoid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RemedyCard'] > JSXAttribute[name.name='naming'] > Literal[value!=/^(?:plain|evidence)$/]",
        "message": "<RemedyCard> naming must be one of 'plain' | 'evidence'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SafetyCallout'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|title|children|style|key|ref|className|style|children)$/]",
        "message": "<SafetyCallout> doesn't accept that prop. Declared props: level, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SafetyCallout'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:caution|serious)$/]",
        "message": "<SafetyCallout> level must be one of 'caution' | 'serious'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|onSubmit|size|autoFocus|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: placeholder, value, onChange, onSubmit, size, autoFocus, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|sm)$/]",
        "message": "<SearchField> size must be one of 'lg' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StudyChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|finding|people|year|url|linkText|lastChecked|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<StudyChip> doesn't accept that prop. Declared props: label, finding, people, year, url, linkText, lastChecked, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StudyField'] > JSXAttribute > JSXIdentifier[name!=/^(?:counts|helped|size|variant|subject|safetyFlag|emptyText|style|key|ref|className|style|children)$/]",
        "message": "<StudyField> doesn't accept that prop. Declared props: counts, helped, size, variant, subject, safetyFlag, emptyText, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StudyField'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:hero|thumb|share)$/]",
        "message": "<StudyField> size must be one of 'hero' | 'thumb' | 'share'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StudyField'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:three|two)$/]",
        "message": "<StudyField> variant must be one of 'three' | 'two'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhereToBuyRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:retailer|price|url|disclosure|style|key|ref|className|style|children)$/]",
        "message": "<WhereToBuyRow> doesn't accept that prop. Declared props: retailer, price, url, disclosure, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
