---
// Home (CHK-B9) — /. Replaces the old S–F tier-board home wholesale (the retiring version is
// gone from this route; the rest of the old presentation layer goes at CHK-B18).
//
// RULES.md enforced, each at the point of enforcement below:
//  · Interface economy: the SEARCH FIELD is the page's largest object. Not by colour — by size
//    and weight. The hero sentence sits above it at body scale, deliberately smaller than the
//    thing it introduces.
//  · Language: NO manifesto and NO self-congratulating stat row. The independence claim is the
//    one quiet line, and it lives in the footer (CHK-B2), not here. None of the banned phrases
//    ("the evidence layer", "reader-funded", "evidence-graded", "zero brand money" …) appears.
//  · Language: never invent a number. The one honest number on this page is a real cited effect
//    stat read from the corpus, rendered with its "see the study" chip — and if the corpus ever
//    stops carrying one, the page falls back to counts of OUR OWN WORK, labelled as such. See
//    the heroStat block below.
//  · Structure: the remedy cards show bucket, safety flag and study thumb as three separate
//    signals; no card merges them, and no grade is guessed (all show "grade in review" until
//    CHK-E6 ratifies).
//  · Root is breadcrumb-exempt (RULES.md: "breadcrumbs on every page (root exempt)").
import Base from '../layouts/Base.astro';
import SearchField from '../components/SearchField.astro';
import RemedyCard from '../components/evidence/RemedyCard.astro';
import PlainStat from '../components/evidence/PlainStat.astro';
import { getCollection } from 'astro:content';
import { studyCounts, safetyInfo, typeWords } from '../lib/remedy/derive.ts';
import { sourceUrl } from '../lib/cite.ts';

const remedies = (await getCollection('remedies')).filter((r) => !r.data.draft);
const byId = new Map(remedies.map((r) => [r.id, r]));

// ── the six most-asked ───────────────────────────────────────────────────────────────────────
// The list the rebuild plan names as the six most-asked (its launch-gate ten starts with these).
// An id that isn't in the corpus is simply skipped — the row never renders a card for a remedy
// that has no page behind it.
const MOST_ASKED = ['melatonin', 'magnesium', 'valerian', 'l-theanine', 'ashwagandha', 'chamomile'];
const cards = MOST_ASKED.map((id) => byId.get(id))
  .filter((r): r is NonNullable<typeof r> => Boolean(r))
  .map((r) => ({
    slug: r.id,
    name: r.data.displayName,
    bucket: r.data.bucket,
    counts: studyCounts(r.data.sources),
    safety: safetyInfo(r.data.safety),
    uses: r.data.outcomes ?? [],
  }));

// ── the one honest number ────────────────────────────────────────────────────────────────────
// PRE-RULED (owner, 18 August 2026): if the corpus carries a plainly-stated, CITED effect stat,
// the hero number is that stat with its "see the study" chip. If it doesn't, the fallback is
// counts of our own work, framed as counts — never as an evidence claim.
//
// We look for the strongest kind of stat only: a source that measured a sleep outcome, whose
// effect data is COMPLETE (so it is adjudicated, not half-filled), that carries a plain-language
// `effectSize` AND a sample size AND a resolvable identifier. Anything less and we fall back —
// a stat without a source id is exactly the number this site exists not to publish.
const statCandidates = remedies.flatMap((r) =>
  r.data.sources
    .filter(
      (s) =>
        s.measuresSleepOutcome === true &&
        s.effectDataStatus === 'complete' &&
        s.effectDirection === 'helped' &&
        s.effectSize &&
        s.sampleSize &&
        (s.pmid || s.doi || s.registry)
    )
    .map((s) => ({ remedy: r, source: s }))
);
// Most people studied first — the widest-evidence stat, not the most flattering one. This is a
// deterministic pick, and it reads no bucket: no grade influences which number the home shows.
statCandidates.sort((a, b) => (b.source.sampleSize ?? 0) - (a.source.sampleSize ?? 0));
const hero = statCandidates[0] ?? null;

// The fallback, if the corpus ever has no qualifying stat: counts of what WE have done. Framed
// as work, never as evidence ("papers read", not "papers that prove anything").
const totalSources = remedies.reduce((n, r) => n + r.data.sources.length, 0);

// Sentence-case the figure's first word: PlainStat's casing rule is that the figure carries the
// sentence's capital and `text` is a lower-case continuation, rendering as ONE sentence.
const heroFigure = hero
  ? hero.source.effectSize!.charAt(0).toUpperCase() + hero.source.effectSize!.slice(1)
  : null;
---

<Base
  title="Somnary — does that sleep remedy actually work?"
  description="Whether a natural sleep remedy has been shown to work, and whether the bottle in your hand delivers what the studies used. Every claim links to the study it came from."
  contain={false}
>
  <div class="wrap">
    {/* ── hero ───────────────────────────────────────────────────────────────────────────── */}
    <div class="hero">
      <h1>
        Somnary tells you whether a sleep remedy actually works — and whether the bottle in your
        hand delivers it.
      </h1>
      {/* the largest object on the page (RULES.md Interface economy). Autofocus: arriving here
          with the cursor already in the field is the whole point of a search-first front door. */}
      <div class="search">
        <SearchField size="lg" autofocus />
      </div>
    </div>

    {/* ── the quiet safety route ─────────────────────────────────────────────────────────── */}
    {/* Quiet, not loud: amber is the safety register (RULES.md Colour), used at tint strength on
        one line rather than as an alarm. It sits above everything browsable because these are
        the readers who should not be browsing. */}
    <a class="safety" href="/safety">
      <span>Taking medication, pregnant, or thinking about this for a child?</span>
      <span class="safety-go">Start here ›</span>
    </a>

    {/* ── situations ─────────────────────────────────────────────────────────────────────── */}
    <section class="sec">
      <h2>Or start with what's going on</h2>
      <ul class="grid situations">
        {/* The first three now point at CHK-B12's problem pages, which is what they were always
            meant to reach — they pointed at filtered browse views only while those pages didn't
            exist. The `?for=` browse arrival stays live and is still used by cross-links. */}
        <li><a href="/problems/cant-fall-asleep">I can't fall asleep<span aria-hidden="true">›</span></a></li>
        <li><a href="/problems/waking-in-the-night">I keep waking in the night<span aria-hidden="true">›</span></a></li>
        <li><a href="/problems/cant-switch-off">I can't switch my head off<span aria-hidden="true">›</span></a></li>
        <li><a href="/remedies/melatonin">I'm thinking about melatonin<span aria-hidden="true">›</span></a></li>
      </ul>
    </section>

    {/* ── most-asked remedies ────────────────────────────────────────────────────────────── */}
    <section class="sec">
      <h2>The ones people ask about most</h2>
      <p class="lede">
        Each card shows what the research says, how risky it is, and how much of it we've been
        able to check — three separate things, never rolled into one score.
      </p>
      <ul class="grid cards">
        {cards.map((c) => (
          <li>
            <RemedyCard slug={c.slug} name={c.name} bucket={c.bucket} counts={c.counts} safety={c.safety} uses={c.uses} />
          </li>
        ))}
      </ul>
      <p class="more"><a href="/remedies">Every remedy we cover ›</a></p>
    </section>

    {/* ── one honest number ──────────────────────────────────────────────────────────────── */}
    <section class="sec stat-sec">
      {hero ? (
        <>
          <h2>What “it works” actually looks like</h2>
          <PlainStat
            figure={heroFigure!}
            source={`${hero.remedy.data.displayName}, from a ${typeWords(hero.source.type)} covering ${hero.source.sampleSize!.toLocaleString()} people`}
            chip={{
              finding: hero.source.finding,
              people: hero.source.sampleSize,
              year: hero.source.year,
              url: sourceUrl(hero.source),
              linkText: 'Read the study',
            }}
          />
          <p class="stat-note">
            That comes from the largest study we've been able to check — a nudge, not a knockout.
            If you're expecting a sleeping pill, none of this is that.
          </p>
        </>
      ) : (
        /* FALLBACK — counts of our own work, labelled as work. Not an evidence claim, and
           deliberately not dressed up as one. */
        <>
          <h2>Where we're up to</h2>
          <PlainStat
            figure={`${remedies.length} remedies`}
            text={`· ${totalSources} papers read`}
            source="Counts of our own work so far — not a claim about what any of it shows"
          />
        </>
      )}
    </section>
  </div>
</Base>

<style>
  /* raw-ok: 880px is the browse column width, matching /products and /remedies — the home's
     card grids need it, and --page-max (720px) is the prose measure. */
  .wrap {
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-5) var(--space-9);
  }

  /* ── hero ── */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-7) 0 var(--space-6);
    text-align: center;
  }
  /* the h1 is deliberately BODY scale, not display scale: the search field below it is the
     page's largest object, and a display-scale headline would take that role away from it */
  h1 {
    margin: 0;
    max-width: 44ch;
    font-size: var(--text-lg);
    font-weight: var(--weight-body);
    line-height: var(--leading-body);
    color: var(--text-muted);
    text-wrap: pretty;
  }
  .search {
    width: 100%;
    max-width: var(--search-max);
  }

  /* ── quiet safety route ── */
  .safety {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-3);
    width: fit-content;
    margin: 0 auto var(--space-9);
    min-height: var(--control-md);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--amber-tint);
    border: var(--border-w) solid var(--amber-line);
    color: var(--text-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    line-height: var(--leading-snug);
    text-decoration: none;
    text-align: center;
  }
  .safety-go {
    font-weight: var(--weight-strong);
    color: var(--amber);
    white-space: nowrap;
  }

  /* ── sections ── */
  .sec {
    padding-bottom: var(--space-9);
  }
  h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xl);
    font-weight: var(--weight-heading);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-snug);
  }
  .lede {
    margin: 0 0 var(--space-5);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--text-muted);
    max-width: var(--measure);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .cards {
    gap: var(--space-4);
  }

  /* ── situation cards ── */
  .situations a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: var(--control-lg);
    padding: var(--space-3) var(--space-4);
    background: var(--surface-card);
    border: var(--border-w) solid var(--border-hairline);
    border-radius: var(--radius-sm);
    color: var(--text-body);
    font-size: var(--text-base);
    font-weight: var(--weight-ui);
    line-height: var(--leading-snug);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-settle);
  }
  .situations a:hover {
    border-color: var(--border-strong);
  }
  .situations span {
    color: var(--text-faint);
  }

  .more {
    margin: var(--space-4) 0 0;
  }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-md);
    color: var(--text-link);
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
  }

  /* ── the one honest number ── */
  .stat-sec {
    border-top: var(--border-w) solid var(--border-hairline);
    padding-top: var(--space-8);
  }
  .stat-note {
    margin: var(--space-4) 0 0;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--text-muted);
    max-width: var(--measure);
  }

  @media (min-width: 600px) {
    .situations {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 860px) {
    .cards {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  @media (min-width: 600px) and (max-width: 859px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .situations a {
      transition: none;
    }
  }
</style>
