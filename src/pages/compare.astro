---
/**
 * /compare — the pair PICKER and crawlable index (L-01, Model 2). The comparison itself lives at
 * one SSG page per pair (/compare/[a]-vs-[b]); this page (a) server-renders every reviewed remedy
 * with its grade so the index is crawlable and no-JS-usable, (b) offers a two-remedy picker that
 * navigates to the canonical pair URL, and (c) links a handful of common comparisons directly.
 * ?a=&b=&goal= is honoured as a client redirect alias to the canonical /compare/[pair]?goal.
 * D4: comparing two remedies is never a suggestion to take both.
 */
import Base from '../layouts/Base.astro';
import TierBadge from '../components/TierBadge.astro';
import ReviewState from '../components/ReviewState.astro';
import ContextBanner from '../components/ContextBanner.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { getCompareEntities, pairSlug } from '../lib/compare-data.ts';
import { OUTCOMES } from '../lib/outcomes.ts';

const entities = await getCompareEntities();
const bySlug = new Map(entities.map((e) => [e.slug, e]));

// A few common comparisons, derived (not authored): for each outcome with ≥2 reviewed remedies,
// pair its two best-graded ones. De-duped, canonical order, capped — real links, no JS needed.
const seen = new Set<string>();
const commonPairs: { a: typeof entities[number]; b: typeof entities[number]; goal: string; goalLabel: string }[] = [];
for (const o of OUTCOMES) {
  const ranked = o.remedies.map((s) => bySlug.get(s)).filter(Boolean) as typeof entities;
  if (ranked.length < 2) continue;
  const [x, y] = ranked;
  const key = pairSlug(x.slug, y.slug);
  if (seen.has(key)) continue;
  seen.add(key);
  const [a, b] = x.slug.localeCompare(y.slug) <= 0 ? [x, y] : [y, x];
  commonPairs.push({ a, b, goal: o.id, goalLabel: o.title });
  if (commonPairs.length >= 6) break;
}
---

<Base
  title="Compare two natural sleep remedies | Somnary"
  description="Pick any two reviewed sleep remedies and compare them side by side on evidence grade and review state, target outcome, effect, form and dose, biggest risk, and documented interaction cautions. Differences first; identical values collapsed. Not a tool for combining remedies. Zero brand money."
  canonical="https://somnary.vercel.app/compare"
>
  <main class="page">
    <header class="head">
      <p class="eyebrow">Tool · compare</p>
      <h1 class="title">Compare two remedies</h1>
      <p class="dek">
        Pick two reviewed remedies and see them side by side on what decides them — evidence grade
        and review state, what each is studied for, the effect, form and dose, the biggest risk,
        and any documented interaction cautions. Differences are shown first; identical values are
        collapsed. Each section says which difference matters and why — it never picks a winner.
      </p>
    </header>

    {/* D4 framing — comparing is NOT combining. */}
    <ContextBanner
      note="This compares how each remedy stands on its own evidence and safety. It is not a tool for combining remedies, and comparing two here is not a suggestion to take both."
    />

    <div class="disclaimer-top">
      <Disclaimer variant="standard" />
    </div>

    {/* the picker — enhanced; navigates to the canonical pair URL */}
    <form class="picker" id="compare-picker" action="/compare" method="get" aria-label="Choose two remedies to compare">
      <div class="picker-fields">
        <label class="field">
          <span class="field-label">First remedy</span>
          <select name="a" class="select" required>
            <option value="" selected disabled>Choose a remedy…</option>
            {entities.map((e) => <option value={e.slug}>{e.name} — grade {e.tier}</option>)}
          </select>
        </label>
        <label class="field">
          <span class="field-label">Second remedy</span>
          <select name="b" class="select" required>
            <option value="" selected disabled>Choose a remedy…</option>
            {entities.map((e) => <option value={e.slug}>{e.name} — grade {e.tier}</option>)}
          </select>
        </label>
        <label class="field">
          <span class="field-label">Goal <span class="opt">(optional)</span></span>
          <select name="goal" class="select">
            <option value="" selected>Any goal</option>
            {OUTCOMES.map((o) => <option value={o.id}>{o.title}</option>)}
          </select>
        </label>
      </div>
      <button type="submit" class="picker-go">Compare →</button>
      <p class="picker-err" id="picker-err" role="alert" hidden>Pick two different remedies.</p>
    </form>

    {/* common comparisons — real canonical links, work with JS off */}
    {commonPairs.length > 0 && (
      <section class="common" aria-labelledby="common-h">
        <h2 id="common-h" class="section-h">Common comparisons</h2>
        <ul class="common-list">
          {commonPairs.map((p) => (
            <li>
              <a class="common-link" href={`/compare/${pairSlug(p.a.slug, p.b.slug)}?goal=${p.goal}`}>
                <span class="common-names">{p.a.name} <span class="vs">vs</span> {p.b.name}</span>
                <span class="common-goal">for {p.goalLabel}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* crawlable index: every reviewed remedy + its grade. No-JS users browse from here. */}
    <section class="all" aria-labelledby="all-h">
      <h2 id="all-h" class="section-h">All reviewed remedies</h2>
      <ul class="all-list">
        {entities.map((e) => (
          <li class="all-item">
            <TierBadge tier={e.tier} size="inline" />
            <a class="all-name" href={`/r/${e.slug}`}>{e.name}</a>
            <span class="all-grade">Grade {e.tier}</span>
            <ReviewState state={e.workflowState} class="all-review" />
          </li>
        ))}
      </ul>
    </section>
  </main>
</Base>

<script>
  // Picker + ?a&b alias. Two roles: (1) if the page was reached with ?a=&b= (the owner's alias URL),
  // redirect to the canonical /compare/[pair]?goal; (2) wire the two selects to navigate on submit.
  // Progressive enhancement only — the common-comparison links and remedy index work with JS off.
  const canonicalPair = (a: string, b: string) =>
    [a, b].sort((x, y) => x.localeCompare(y)).join('-vs-');

  const params = new URLSearchParams(location.search);
  const qa = params.get('a');
  const qb = params.get('b');
  const known = new Set(
    Array.from(document.querySelectorAll<HTMLOptionElement>('select[name="a"] option[value]'))
      .map((o) => o.value)
      .filter(Boolean),
  );
  if (qa && qb && qa !== qb && known.has(qa) && known.has(qb)) {
    const goal = params.get('goal');
    location.replace(`/compare/${canonicalPair(qa, qb)}${goal ? `?goal=${encodeURIComponent(goal)}` : ''}`);
  }

  const form = document.getElementById('compare-picker') as HTMLFormElement | null;
  const err = document.getElementById('picker-err');
  form?.addEventListener('submit', (ev) => {
    ev.preventDefault();
    const data = new FormData(form);
    const a = String(data.get('a') || '');
    const b = String(data.get('b') || '');
    const goal = String(data.get('goal') || '');
    if (!a || !b || a === b) {
      if (err) err.hidden = false;
      return;
    }
    if (err) err.hidden = true;
    location.assign(`/compare/${canonicalPair(a, b)}${goal ? `?goal=${encodeURIComponent(goal)}` : ''}`);
  });
</script>

<style>
  .page {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--sp-8) var(--sp-7) var(--sp-9);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    margin: 0;
  }
  .head {
    margin-bottom: var(--sp-6);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-3xl);
    line-height: var(--lh-3xl);
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
    margin: var(--sp-3) 0 var(--sp-4);
  }
  .dek {
    font-size: var(--text-md);
    line-height: var(--lh-md);
    color: var(--muted);
    max-width: 70ch;
    margin: 0;
  }
  .disclaimer-top {
    margin: var(--sp-5) 0 var(--sp-6);
  }

  /* picker */
  .picker {
    background: var(--surface);
    border: var(--border-hairline);
    border-radius: var(--r-lg);
    padding: var(--sp-5);
    margin-bottom: var(--sp-6);
  }
  .picker-fields {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--sp-4);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    min-width: 0;
  }
  .field-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
  }
  .opt {
    color: var(--soft);
  }
  .select {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--ink);
    background: var(--paper);
    border: var(--border-hairline);
    border-radius: var(--r-md);
    padding: var(--sp-3) var(--sp-4);
    width: 100%;
  }
  .select:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  .picker-go {
    margin-top: var(--sp-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    color: var(--surface);
    background: var(--primary);
    border: 1px solid var(--primary); /* raw-ok: 1px control border, matches buttons */
    border-radius: var(--r-pill);
    padding: var(--sp-3) var(--sp-5);
    cursor: pointer;
  }
  .picker-go:hover {
    background: var(--primary-deep);
    border-color: var(--primary-deep);
  }
  .picker-go:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  .picker-err {
    margin: var(--sp-3) 0 0;
    font-size: var(--text-sm);
    color: var(--safety-ink);
  }

  /* section shells */
  .section-h {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--lh-xl);
    color: var(--ink);
    margin: 0 0 var(--sp-4);
  }
  .common {
    margin-bottom: var(--sp-7);
  }
  .common-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .common-link {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    background: var(--surface);
    border: var(--border-hairline);
    border-radius: var(--r-md);
    padding: var(--sp-4);
    text-decoration: none;
  }
  .common-link:hover {
    border-color: var(--primary);
  }
  .common-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  .common-names {
    font-family: var(--font-display);
    font-size: var(--text-md);
    color: var(--ink);
  }
  .vs {
    color: var(--muted);
    font-weight: 400;
  }
  .common-goal {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
  }

  /* remedy index */
  .all-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .all-item {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) 0;
    border-top: var(--border-hairline);
  }
  .all-name {
    font-family: var(--font-display);
    font-size: var(--text-md);
    color: var(--ink);
    text-decoration: none;
  }
  .all-name:hover {
    color: var(--primary);
  }
  .all-name:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--r-xs);
  }
  .all-grade {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    margin-left: auto;
  }

  @media (max-width: 640px) {
    .page {
      padding: var(--sp-6) var(--sp-5) var(--sp-8);
    }
    .title {
      font-size: var(--text-2xl);
    }
    .picker-fields {
      grid-template-columns: 1fr;
    }
  }
</style>
