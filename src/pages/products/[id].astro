---
// Product page (CHK-B7) — /products/{id}, where the id is already {brand-slug}-{product-slug}.
// Replaces B3's sample page on the same route. Consumes B3's product/brand collections, B4's
// /go redirect, B5's evidence primitives, and B6's row primitives + the ruled verdict.
//
// RULES.md enforced, each at the point of enforcement below:
//  · Products: a DECISION NARRATIVE — no table of contents, no sidebar; the section order IS the
//    argument, read top to bottom. The one jump on the page is "Where to buy ↓".
//  · Products: we list EVERY product, including ones we advise against, and the where-to-buy row
//    is IDENTICAL regardless of the verdict, with the warning intact above it. Nothing on this
//    page consults a price, a retailer or a commercial relationship to decide what to show.
//  · "Never merged": three separate signals appear here and stay separate — the ingredient's
//    evidence BUCKET (about the ingredient, links to its remedy page), the SAFETY FLAG (shown
//    alongside, never folded into either), and this bottle's product VERDICT. No combined number
//    exists anywhere on the page.
//  · Products: anecdote never appears at the point of purchase. There is no "what people report"
//    section here by design — it lives on the remedy page, behind the community firewall.
//  · Language: no invented numbers, and no "[Placeholder" strings (they fail the build, Rui.3).
//    Every section below either renders real data or says plainly what we don't hold yet.
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProductObject from '../../components/products/ProductObject.astro';
import BrandMark from '../../components/products/BrandMark.astro';
import VerdictPill from '../../components/products/VerdictPill.astro';
import RetailLink from '../../components/RetailLink.astro';
import BucketBadge from '../../components/evidence/BucketBadge.astro';
import SafetyCallout from '../../components/evidence/SafetyCallout.astro';
import { CRITERIA, VERDICTS, byChecksPassed, checkValues, completeness, verdictState } from '../../lib/products/score.ts';
import { formLabel, RELEASE_LABEL } from '../../lib/products/labels.ts';
import { safetyInfo } from '../../lib/remedy/derive.ts';

type Remedy = CollectionEntry<'remedies'>;

export async function getStaticPaths() {
  const products = await getCollection('products');
  const remedies = await getCollection('remedies');
  const brands = await getCollection('brands');
  return products.map((p) => ({
    params: { id: p.id },
    props: {
      product: p.data,
      productId: p.id,
      // CHK-B11 built /brands/{slug}, so the brand crumb and the header brand line are links
      // again — the thing B7 deliberately left unlinked rather than ship 93 dead breadcrumbs.
      brand: brands.find((b) => b.data.name === p.data.brand)?.data ?? null,
      // every remedy this bottle contains, in label order (90 of 93 are single-ingredient)
      remedies: p.data.ingredients
        .map((i) => remedies.find((r) => r.id === i.remedy_id))
        .filter((r): r is Remedy => Boolean(r)),
      // other products sharing this bottle's first ingredient — the "if this isn't right for you"
      // row. Ordered by the SAME ruled order as the browse list, never by price or retailer.
      siblings: products
        .filter(
          (o) =>
            o.id !== p.id &&
            o.data.ingredients.some((i) => p.data.ingredients.some((j) => j.remedy_id === i.remedy_id))
        )
        .sort((a, b) => byChecksPassed(a.data, b.data))
        .slice(0, 3)
        .map((o) => ({ id: o.id, data: o.data })),
    },
  }));
}

const { product, productId, brand, remedies, siblings } = Astro.props;

const state = completeness(product);
const verdict = state === 'assessed' ? verdictState(product) : null;
const values = checkValues(product);
const strength = product.strength ? `${product.strength.amount} ${product.strength.unit}` : null;
const primary = remedies[0] ?? null;
const safety = primary ? safetyInfo(primary.data.safety) : null;

// The "what it is" line, composed from structured fields — the name NEVER carries the dose
// (schema rule), so strength arrives here and only here.
const factLine = [
  strength ?? 'Strength not recorded yet',
  formLabel(product.deliveryForm),
  // release only when the label actually stated it — 'not-stated' is never dressed up as a fact
  product.releaseProfile === 'not-stated' ? null : RELEASE_LABEL[product.releaseProfile],
]
  .filter(Boolean)
  .join(' · ');

// Dates render "14 July 2026", never ISO (RULES.md Identity).
const longDate = (iso: string | null | undefined) =>
  iso
    ? new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      })
    : null;

// ── the four checks, with the working shown ──────────────────────────────────────────────────
// WHY EACH CHECK LANDED WHERE IT DID, from this product's own data. Nothing here is authored per
// product: each line states the fact the check read. A failed check is explained exactly as
// plainly as a passing one (RULES.md: identical treatment), and an unresolved one says so rather
// than being written up as a failure.
function working(key: (typeof CRITERIA)[number]['key']): string {
  const v = values[key];
  switch (key) {
    case 'dose':
      if (v === null)
        return strength
          ? `The label says ${strength}. We haven't yet checked that against the doses the studies used.`
          : "We don't hold a strength for this product yet, so there is nothing to check against the studied doses.";
      return v
        ? 'The amount in this product sits inside the range the studies used.'
        : "The amount in this product is outside the range the studies used — so the research doesn't describe what's in this bottle.";
    case 'tested':
      if (product.third_party_tested)
        return `${product.third_party_tested.organisation} verified the contents against the label${
          longDate(product.third_party_tested.verified_date) ? ` on ${longDate(product.third_party_tested.verified_date)}` : ''
        }.`;
      return v === null
        ? "We haven't yet found an independent test of this product. That's a gap in our record, not a finding about the product."
        : "No independent laboratory has verified what's in this bottle. A manufacturer's own certificate is not a substitute.";
    case 'disclosed':
      if (v === null)
        return product.composition === 'blend'
          ? "This is a blend, and we haven't yet recorded whether it discloses each ingredient's amount."
          : "We haven't yet checked whether the label discloses everything in it.";
      return v
        ? 'Every ingredient and its amount is printed on the label — no proprietary blend hiding the numbers.'
        : 'Some of what is in this bottle sits inside a proprietary blend, so the individual amounts are not printed. That single device is what fails this check.';
    case 'form':
      if (v === null)
        return product.deliveryForm
          ? `This is a ${formLabel(product.deliveryForm).toLowerCase()}. We haven't yet checked whether that is the form the studies used.`
          : "We haven't mapped this label's wording to a form yet, so there is nothing to compare with the studied form.";
      return v
        ? 'This is the form the studies actually used, so the results describe this kind of product.'
        : "This isn't the form the studies used, so their results don't straightforwardly carry over to it.";
  }
}

const checkRows = CRITERIA.map((c) => ({ ...c, value: values[c.key], why: working(c.key) }))
  // failed checks float to the top — the reason the page exists is what it does NOT deliver
  .sort((a, b) => Number(a.value === true) - Number(b.value === true));

const retailers = product.retail_links;
const pageTitle = `${product.brand} ${product.name} — is it what the studies used? | Somnary`;
---

<Base
  title={pageTitle}
  description={`${product.brand} ${product.name}${strength ? `, ${strength}` : ''} — what's on the label, and whether the bottle delivers what the research actually tested.`}
  contain={false}
>
  <div class="wrap">
    {/* breadcrumbs on every page; mobile truncates to "‹ Products" (the shared component) */}
    {/* Products › Brand › Product, the bundle's full trail — restored at CHK-B11 when
        /brands/{slug} landed. Falls back to the short trail if a product's brand has no record. */}
    <Breadcrumb
      trail={brand
        ? [{ label: 'Products', href: '/products' }, { label: product.brand, href: `/brands/${brand.slug}` }]
        : [{ label: 'Products', href: '/products' }]}
      current={product.name}
    />

    {/* ── header ─────────────────────────────────────────────────────────────────────────── */}
    <div class="head">
      <span class="shot"><ProductObject brand={product.brand} form={product.deliveryForm} radius="var(--radius-lg)" /></span>
      <div class="head-text">
        {brand ? <a class="brand brand-link" href={`/brands/${brand.slug}`}>{product.brand}</a> : <p class="brand">{product.brand}</p>}
        <h1>{product.name}</h1>
        <p class="fact">{factLine}</p>

        {/* ── the paired verdict, first ──────────────────────────────────────────────────
            Two questions, never merged into one: does the INGREDIENT work (its bucket, which
            belongs to the remedy and links there), and does THIS BOTTLE deliver it (the ruled
            verdict). The safety flag sits alongside both — so a serious-concern remedy is
            never presented as a clean buy (CLAUDE.md three signals / RULES.md structure). */}
        <div class="verdict">
          <VerdictPill product={product} />
          {verdict && <p class:list={['verdict-line', verdict]}>{VERDICTS[verdict].sentence}</p>}
          {!verdict && state === 'label-known' && (
            <p class="verdict-line pending">
              We have this label, but we haven't put the bottle through the four checks yet — so
              there's no verdict here to give you.
            </p>
          )}
        </div>

        {/* the visible route to how the verdict is decided — present whether or not this bottle
            has been assessed, because the reader asking "how do you decide?" is most likely the
            one looking at a product that hasn't been. */}
        <p class="how">
          <a href="/how-we-grade#product-verdict">How we decide this <span aria-hidden="true">›</span></a>
        </p>

        {primary && (
          <div class="ingredient">
            <p class="ing-line">
              {product.ingredients.length > 1 ? 'Main ingredient: ' : 'Active ingredient: '}
              {remedies.map((r, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`/remedies/${r.id}`}>{r.data.displayName}</a>
                </>
              ))}
            </p>
            {/* the ingredient's evidence bucket — a SEPARATE signal from the verdict above, and
                the remedy's property, not this bottle's. null until CHK-E6 ratifies it, and a
                pending chip is shown rather than a guessed grade (HUMAN-GATE). Every bucket
                badge links to how-we-grade (RULES.md Interface economy). */}
            {primary.data.bucket ? (
              <a class="bucket-link" href={`/how-we-grade#${primary.data.bucket}`}>
                <BucketBadge bucket={primary.data.bucket} compact />
              </a>
            ) : (
              <a class="pending-chip" href="/how-we-grade#in-review">Grade in review</a>
            )}
          </div>
        )}

        {safety?.serious && (
          <p class="flag-serious">
            <a href={`/remedies/${primary!.id}#safe`}>This ingredient carries a serious safety concern ↓</a>
          </p>
        )}

        {/* the ONE jump on the page (RULES.md: no TOC, one "Where to buy ↓"). It sits AFTER the
            verdict, not before it: the verdict is what the page is for, and a utility jump has
            no business being the first thing under the title. */}
        {retailers.length > 0 && <a class="jump" href="#buy">Where to buy ↓</a>}
      </div>
    </div>

    {/* ── the four checks ────────────────────────────────────────────────────────────────── */}
    <section class="sec">
      <h2>The four checks</h2>
      <p class="lede">
        These are about the bottle, not about whether the ingredient works. That question is
        answered on {primary ? <a href={`/remedies/${primary.id}`}>its remedy page</a> : 'its remedy page'}.
      </p>
      <ul class="checks">
        {checkRows.map((c) => (
          <li class:list={['check', c.value === true ? 'met' : c.value === false ? 'failed' : 'unknown']}>
            <span class="mark" aria-hidden="true">
              {c.value === true ? (
                <svg width="16" height="16" viewBox="0 0 14 14">
                  <path d="M2.5 7.5 L5.5 10.5 L11.5 3.5" fill="none" stroke="var(--sage)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              ) : c.value === false ? (
                <svg width="16" height="16" viewBox="0 0 14 14">
                  <path d="M3.5 3.5 L10.5 10.5 M10.5 3.5 L3.5 10.5" fill="none" stroke="var(--bucket-avoid)" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              ) : (
                <svg width="16" height="16" viewBox="0 0 14 14">
                  <line x1="3" y1="7" x2="11" y2="7" stroke="var(--text-faint)" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              )}
            </span>
            <div>
              <p class="check-label">
                {c.label} — {c.value === true ? 'yes' : c.value === false ? 'no' : 'not checked yet'}
              </p>
              <p class="check-why">{c.why}</p>
            </div>
          </li>
        ))}
      </ul>
      {verdict && (
        <p class="rule-note">
          {verdict === 'falls-short'
            ? 'Dose and form decide this one on their own: if a bottle is not what the studies tested, the paperwork checks cannot make up for it.'
            : verdict === 'unverified'
              ? "It's the right thing — we just can't independently confirm what the label says."
              : 'All four hold, so the research describes what is in this bottle.'}{' '}
          <a href="/how-we-grade#product-verdict">How we decide this</a>
        </p>
      )}
    </section>

    {/* ── what's in it ───────────────────────────────────────────────────────────────────── */}
    <section class="sec">
      <h2>What's in it</h2>
      <ul class="ings">
        {product.ingredients.map((i) => {
          const r = remedies.find((x) => x.id === i.remedy_id);
          return (
            <li>
              <p class="ing-name">
                {r ? r.data.displayName : i.remedy_id}
                {i.amount && i.unit && <span class="amt"> · {i.amount} {i.unit}</span>}
              </p>
              {i.form && <p class="ing-note">{i.form}</p>}
            </li>
          );
        })}
      </ul>
      {/* Additive flags: three states only, each non-neutral one citing its paper (RULES.md
          Products). No excipients are recorded for any product yet — so rather than render an
          empty list that reads as "nothing else in it", the page says what it doesn't hold.
          NO hazard score and no invented gradient, ever. */}
      {product.excipients.length > 0 ? (
        <ul class="ings">
          {product.excipients.map((e) => (
            <li class:list={['excipient', e.flag]}>
              <p class="ing-name">
                {e.name}
                {e.amount && <span class="amt"> · {e.amount}</span>}
              </p>
              <p class="ing-note">
                {e.role}
                {' · '}
                {e.flag === 'no-known-concern' ? 'No known concern' : e.flag === 'worth-knowing' ? 'Worth knowing' : 'Documented concern'}
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">
          We haven't recorded the rest of this label yet — the fillers, sweeteners, colours and
          coatings. Until we have, treat the list above as the active ingredients only, not the
          full contents.
        </p>
      )}
      <p class="note">
        We flag only documented concerns, and every flag cites the paper that earned it. We don't
        publish hazard scores. "No known concern" means nothing documented at these amounts — not
        a guarantee.
      </p>
      {product.allergens.length > 0 && <p class="note">Per the label: {product.allergens.join(', ')}.</p>}
    </section>

    {/* ── dose ───────────────────────────────────────────────────────────────────────────── */}
    <section class="sec">
      <h2>Is the dose enough?</h2>
      {/* THE DOSE DIAGRAM IS NOT BUILT HERE, DELIBERATELY. The plan has it consuming the remedy's
          dose context, but `doses[].studiedDose` is free PROSE, not a structured range — and it
          carries meaning a number cannot ("150 mg nightly was tested in insomnia, with no benefit
          on the primary outcomes", "Studied for anxiety", "Not established for sleep"). Regex a
          figure out of those and the page states a studied dose the paper never supported, which
          is inventing a number (RULES.md Language) with a citation-shaped hole under it. So the
          real prose is rendered as written, beside this bottle's actual strength, and the reader
          does the comparison with everything in view. The diagram needs a structured studied
          range on the remedy schema — a HUMAN-GATE schema change plus editorial fill; see the
          checklist note against CHK-B7 / CHK-E4. */}
      <p class="lede">
        This bottle: <strong>{strength ?? 'strength not recorded yet'}</strong>
        {product.deliveryForm && <> per {formLabel(product.deliveryForm).toLowerCase()}</>}.
      </p>
      {primary && primary.data.doses.length > 0 ? (
        <>
          <p class="lede">What the studies used, in {primary.data.displayName}'s own words:</p>
          <dl class="doses">
            {primary.data.doses.map((d) => (
              <div class="dose-row">
                <dt>{d.form}</dt>
                <dd>
                  <p class="dose-studied">{d.studiedDose}</p>
                  {d.timing && <p class="dose-meta">When: {d.timing}</p>}
                  {d.marketComparison && <p class="dose-meta">On the shelf: {d.marketComparison}</p>}
                </dd>
              </div>
            ))}
          </dl>
        </>
      ) : (
        <p class="empty">
          We don't hold a studied dose for this ingredient yet, so there's nothing to measure this
          bottle against.
        </p>
      )}
    </section>

    {/* ── safety ─────────────────────────────────────────────────────────────────────────── */}
    {primary && safety && (
      <section class="sec">
        <h2>Before you take it</h2>
        {/* The safety copy is the REMEDY's sourced data, passed in — never authored here
            (SafetyCallout's content rule; this has drifted three times). It applies to every
            product with this ingredient, not just this bottle, and says so. */}
        <SafetyCallout level={safety.level}>
          {safety.lead}{' '}
          <a href={`/remedies/${primary.id}#safe`}>
            The full safety picture is on the {primary.data.displayName} page
          </a>{' '}
          — it applies to every {primary.data.displayName.toLowerCase()} product, not just this one.
        </SafetyCallout>
      </section>
    )}

    {/* ── alternatives ───────────────────────────────────────────────────────────────────── */}
    {siblings.length > 0 && (
      <section class="sec">
        <h2>If this isn't right for you</h2>
        <p class="lede">
          Other products with the same ingredient. Same four checks, in the same order we use
          everywhere — these are assessments, not recommendations.
        </p>
        <ul class="alts">
          {siblings.map((s) => (
            <li>
              <a class="alt" href={`/products/${s.id}`} aria-label={`${s.data.brand} ${s.data.name}`}>
                <BrandMark name={s.data.brand} size={44} radius="var(--radius-sm)" />
                <span class="alt-text">
                  <span class="alt-name">{s.data.brand} — {s.data.name}</span>
                  {s.data.strength && <span class="alt-meta">{s.data.strength.amount} {s.data.strength.unit}</span>}
                </span>
                <span class="alt-pill"><VerdictPill product={s.data} /></span>
              </a>
            </li>
          ))}
        </ul>
        {/* a standalone navigation target (the link IS the paragraph), so the 44px floor applies
            — unlike the links inside sentences on this page, which take the inline exemption. */}
        <p class="note"><a class="more" href="/products">Every product we've catalogued, including the ones we'd skip ›</a></p>
      </section>
    )}

    {/* ── provenance ─────────────────────────────────────────────────────────────────────── */}
    <section class="sec">
      <h2>Where this comes from</h2>
      <ul class="prov">
        <li>The label — as printed, recorded {longDate(product.last_checked) ?? 'when we catalogued it'}.</li>
        <li>
          The research — the papers on{' '}
          {primary ? <a href={`/remedies/${primary.id}#research`}>the {primary.data.displayName} page</a> : 'the remedy page'}.
        </li>
        {product.third_party_tested && (
          <li>
            Independent testing — {product.third_party_tested.organisation}
            {longDate(product.third_party_tested.verified_date) ? `, ${longDate(product.third_party_tested.verified_date)}` : ''}.
          </li>
        )}
      </ul>
      <div class="correct">
        <p class="correct-h">Spotted something wrong?</p>
        <p class="note">
          Formulations change, and this page is only as good as its last check.{' '}
          <a href="/request-a-review">Tell us</a> and we'll re-check it.
        </p>
      </div>
    </section>

    {/* ── where to buy ───────────────────────────────────────────────────────────────────── */}
    <section class="sec" id="buy">
      <h2>Where to buy</h2>
      {/* IDENTICAL TREATMENT regardless of the verdict (RULES.md Products / non-negotiable 1):
          this block reads no score and no verdict, so it renders the same on a product we rate
          well and one we advise against. The warning above it stays where it is — it is not
          softened, moved, or hidden here. Retailers are in the order the record holds them,
          never ordered by anything commercial, and every link goes through /go (CHK-B4). */}
      {verdict === 'falls-short' && (
        <p class="buy-warning">
          Worth repeating before you click: this bottle isn't what the studies tested. We still
          list where to buy it — that's your call to make, not ours to hide.
        </p>
      )}
      {retailers.length > 0 ? (
        <>
          <ul class="buys">
            {retailers.map((r) => (
              <li><RetailLink productId={productId} retailer={r.retailer} /></li>
            ))}
          </ul>
          <p class="note">
            Retailers in no particular order. Nobody pays us to list them, and no link here
            changed a single check above.
          </p>
        </>
      ) : (
        <p class="empty">
          We don't have a retailer on record for this one. That's a gap in our record — it doesn't
          mean the product is unavailable.
        </p>
      )}
    </section>
  </div>
</Base>

<style>
  /* raw-ok: 720px matches --page-max as a layout width; this page is a reading narrative, so it
     keeps the prose column rather than the browse list's wider 880px. */
  .wrap {
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-5) var(--space-5) var(--space-9);
  }

  /* ── header ── */
  .head {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: flex-start;
  }
  .head-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    width: 100%;
  }
  .brand-link {
    display: inline-flex;
    align-items: center;
    /* 44px hit floor (RULES.md a11y) */
    min-height: var(--control-md);
    color: var(--text-link);
    text-decoration: none;
  }
  .brand-link:hover {
    text-decoration: underline;
  }
  .brand {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    color: var(--text-muted);
  }
  h1 {
    margin: 0;
    font-size: var(--display-md);
    font-weight: var(--weight-title);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
    text-wrap: pretty;
  }
  .fact {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--weight-ui);
    color: var(--text-body);
    font-variant-numeric: tabular-nums;
  }
  .jump {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: var(--control-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    color: var(--text-link);
  }
  .verdict {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .verdict-line {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: var(--weight-ui);
    line-height: var(--leading-snug);
    max-width: var(--measure);
  }
  .verdict-line.delivers,
  .verdict-line.unverified {
    color: var(--text-body);
  }
  /* the avoid register carries a documented failure, and only that (RULES.md Colour) */
  .verdict-line.falls-short {
    color: var(--bucket-avoid);
  }
  .verdict-line.pending {
    color: var(--text-muted);
    font-size: var(--text-base);
  }
  .how {
    margin: 0;
  }
  .how a {
