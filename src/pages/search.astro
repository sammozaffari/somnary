---
// Search (CHK-B14 / CHK-Rui.2) — /search?q=…. Replaces the old search page on the same route.
// This is where the nav's ever-present field and the home hero both submit.
//
// SERVER-RENDERED, deliberately (`prerender = false`). The whole point of a form-GET search
// field is that it works without JavaScript, and a static page cannot answer a query. Results
// are resolved on the server from the one index, so the page is complete on first paint, is
// crawlable, and is shareable as a URL.
//
// The tier rules live in lib/search/resolve.ts as a pure module — see the rule commentary there.
// This file renders them and adds nothing: no re-ranking, no re-ordering, no commercial signal.
export const prerender = false;

import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SearchField from '../components/SearchField.astro';
import { buildIndex } from '../lib/search/index.ts';
import { resolve, type Entry } from '../lib/search/resolve.ts';

const q = Astro.url.searchParams.get('q') ?? '';
const entries = await buildIndex();
const res = resolve(q, entries);

const KIND_LABEL: Record<Entry['kind'], string> = {
  remedy: 'Remedy',
  product: 'Product',
  brand: 'Brand',
  problem: 'Situation',
  page: 'Page',
};
// group tier 3 by kind so a long list reads as a structure, not a pile
const groups = (['remedy', 'problem', 'product', 'brand', 'page'] as const)
  .map((k) => ({ kind: k, items: res.more.filter((e) => e.kind === k) }))
  .filter((g) => g.items.length > 0);
---

<Base
  title={q ? `${q} — search | Somnary` : 'Search | Somnary'}
  description="Search remedies, products, brands and situations."
  contain={false}
>
  <div class="wrap">
    <Breadcrumb trail={[{ label: 'Somnary', href: '/' }]} current="Search" />

    <h1>Search</h1>
    <div class="field"><SearchField size="lg" value={q} autofocus={!q} /></div>

    {res.kind === 'empty' && (
      <p class="hint">
        Type a remedy, a product, a brand, or what's going on — “melatonin”, “Blackmores”,
        “5 mg gummies”, “I keep waking”.
      </p>
    )}

    {res.kind === 'short' && (
      <p class="hint">A little more to go on — two letters match too much to be useful.</p>
    )}

    {/* ── the category rule: return the category, never a sample of its members ───────────── */}
    {res.kind === 'category' && (
      <section class="results">
        <p class="tier-label">That's a whole category</p>
        <p class="hint">
          Rather than show you an arbitrary handful, here's the whole thing — browse it and you'll
          see everything, in our published order.
        </p>
        <ul class="rows">
          {res.categories.map((c) => (
            <li>
              <a class="row category" href={c.href}>
                <span class="row-name">All {c.label}</span>
                <span class="row-meta">{c.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* ── tier 1 · the answer ─────────────────────────────────────────────────────────────── */}
    {res.kind === 'answer' && res.answer && (
      <section class="results">
        <p class="tier-label">{KIND_LABEL[res.answer.kind]}</p>
        <a class="answer" href={res.answer.href}>
          <span class="answer-name">{res.answer.name}</span>
          {res.answer.meta && <span class="answer-meta">{res.answer.meta}</span>}
        </a>

        {/* ── tier 2 · routes ── */}
        {res.routes.length > 0 && (
          <>
            <p class="tier-label">Also worth reading</p>
            <ul class="rows">
              {res.routes.map((e) => (
                <li>
                  <a class="row" href={e.href}>
                    <span class="row-name">{e.name}</span>
                    <span class="row-kind">{KIND_LABEL[e.kind]}</span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    )}

    {/* ── tier 3 · everything else that matched ───────────────────────────────────────────── */}
    {(res.kind === 'list' || (res.kind === 'answer' && groups.length > 0)) && (
      <section class="results">
        <p class="tier-label">
          {res.kind === 'answer' ? 'Other matches' : `${res.more.length} ${res.more.length === 1 ? 'match' : 'matches'}`}
        </p>
        {groups.map((g) => (
          <>
            <p class="group-label">{KIND_LABEL[g.kind]}{g.items.length > 1 ? 's' : ''}</p>
            <ul class="rows">
              {g.items.map((e) => (
                <li>
                  <a class="row" href={e.href}>
                    <span class="row-name">{e.name}</span>
                    {e.meta && <span class="row-meta">{e.meta}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </>
        ))}
      </section>
    )}

    {/* ── no match ────────────────────────────────────────────────────────────────────────── */}
    {res.kind === 'nomatch' && (
      <section class="results">
        <p class="none">
          Nothing here matches “{q}”.
          {res.suggestion && <> Did you mean <a href={`/search?q=${encodeURIComponent(res.suggestion)}`}>{res.suggestion}</a>?</>}
        </p>
        <p class="hint">
          We cover {entries.filter((e) => e.kind === 'remedy').length} remedies and{' '}
          {entries.filter((e) => e.kind === 'product').length} products — if we're missing
          something, <a href="/request-a-review">tell us</a> and we'll look at adding it.
        </p>
        <ul class="rows">
          <li><a class="row" href="/remedies"><span class="row-name">Browse every remedy</span></a></li>
          <li><a class="row" href="/products"><span class="row-name">Browse every product</span></a></li>
        </ul>
      </section>
    )}
  </div>
</Base>

<style>
  /* raw-ok: 720px matches --page-max; a result list is a reading column. */
  .wrap {
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-5) var(--space-5) var(--space-9);
  }
  h1 {
    margin: var(--space-1) 0 var(--space-4);
    font-size: var(--display-md);
    font-weight: var(--weight-title);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }
  .field {
    max-width: var(--search-max);
    margin-bottom: var(--space-6);
  }
  .hint,
  .none {
    margin: 0 0 var(--space-4);
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--text-muted);
    max-width: var(--measure);
  }
  .none {
    color: var(--text-body);
    font-weight: var(--weight-ui);
  }
  .hint a,
  .none a {
    color: var(--text-link);
    font-weight: var(--weight-ui);
  }
  .results {
    padding-top: var(--space-2);
  }
  .tier-label {
    margin: var(--space-6) 0 var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    color: var(--text-muted);
    letter-spacing: var(--tracking-display);
  }
  .group-label {
    margin: var(--space-4) 0 var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    color: var(--text-faint);
  }

  /* tier 1 answer — the biggest object in the results, by size not colour */
  .answer {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5);
    background: var(--surface-card);
    border: var(--border-w) solid var(--border-strong);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-body);
  }
  .answer:hover {
    border-color: var(--ink);
  }
  .answer-name {
    font-size: var(--text-xl);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-display);
  }
  .answer-meta {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    /* 44px hit floor (RULES.md a11y) */
    min-height: var(--control-md);
    padding: var(--space-2) var(--space-3);
    border-bottom: var(--border-w) solid var(--border-hairline);
    text-decoration: none;
    color: var(--text-body);
  }
  .row:hover {
    background: var(--surface-card);
  }
  .row-name {
    font-size: var(--text-base);
    font-weight: var(--weight-ui);
  }
  .row-meta,
  .row-kind {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .category .row-name {
    font-weight: var(--weight-strong);
  }
</style>
