---
// Outcome page — CHK-5.2 (PLAN §2.3, DESIGN_SYSTEM §3.4). Goal-first entry: for a sleep goal, the
// remedies with evidence for it, ranked BEST EVIDENCE FIRST (by their own tier) — never by anecdote.
// Reads the outcome→remedy map (src/lib/outcomes.ts) + the remedies collection. Static/crawlable.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TierBadge from '../../components/TierBadge.astro';
import ReviewState from '../../components/ReviewState.astro';
import { OUTCOMES } from '../../lib/outcomes';
import type { TierId } from '../../lib/tiers';
import {
  isDefaultRankingEligible,
  isOrdinarySearchEligible,
  type WorkflowState,
} from '../../lib/remedy-state';

export async function getStaticPaths() {
  const remedies = await getCollection(
    'remedies',
    (e) => !e.data.draft && isOrdinarySearchEligible(e.data),
  );
  const bySlug = new Map(remedies.map((e) => [e.id, e.data]));
  const rank: Record<TierId, number> = { S: 0, A: 1, B: 2, C: 3, D: 4, F: 5 };
  return OUTCOMES.map((o) => {
    const items = o.remedies
      .map((slug) => {
        const d = bySlug.get(slug);
        return d
          ? {
              slug,
              name: d.name,
              tier: d.tier as TierId,
              workflowState: d.workflowState as WorkflowState,
              oneLiner: d.oneLineVerdict,
              rankingEligible: isDefaultRankingEligible(d),
            }
          : null;
      })
      .filter((x): x is NonNullable<typeof x> => x !== null);
    const rankedItems = items
      .filter((item) => item.rankingEligible)
      .sort((a, b) => rank[a.tier] - rank[b.tier]);
    const underReviewItems = items
      .filter((item) => !item.rankingEligible)
      .sort((a, b) => a.name.localeCompare(b.name));
    return { params: { slug: o.id }, props: { outcome: o, rankedItems, underReviewItems } };
  });
}

const { outcome, rankedItems, underReviewItems } = Astro.props;
const others = OUTCOMES.filter((o) => o.id !== outcome.id);
---

<Base
  title={`${outcome.title}: sleep remedies by evidence | Somnary`}
  description={`${outcome.dek}. Review-complete grades are ranked by evidence; provisional grades remain visible in a separate under-review group.`}
  canonical={`https://somnary.vercel.app/outcome/${outcome.id}`}
>
  <main class="page">
    <header class="head">
      <p class="crumb"><a href="/">Somnary</a> <span aria-hidden="true">›</span> By outcome</p>
      <p class="eyebrow">By outcome · review-complete evidence first</p>
      <h1 class="title">{outcome.title}</h1>
      <p class="dek">
        {outcome.dek}: review-complete grades are ranked by the strength of the human evidence, not
        by popularity.
      </p>
    </header>

    <!-- goal switcher -->
    <nav class="switcher" aria-label="Switch goal">
      {
        OUTCOMES.map((o) => (
          <a
            class:list={['chip', { active: o.id === outcome.id }]}
            href={`/outcome/${o.id}`}
            aria-current={o.id === outcome.id ? 'page' : undefined}
          >
            {o.title}
          </a>
        ))
      }
    </nav>

    <!-- ranked list -->
    <ol class="ranked" aria-label={`Remedies for ${outcome.title}, best evidence first`}>
      {
        rankedItems.map((r, i) => (
          <li>
            <a class="row" href={`/r/${r.slug}`}>
              <span class="idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <TierBadge tier={r.tier} size="card" />
              <span class="row-main">
                <span class="row-name">{r.name}</span>
                <span class="row-note">{r.oneLiner}</span>
              </span>
              <span class="row-status">
                <span class="row-grade">Grade {r.tier}</span>
                <ReviewState state={r.workflowState} />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    {
      rankedItems.length === 0 && (
        <p class="ranking-empty">
          No review-complete remedy is ranked for this outcome yet.
        </p>
      )
    }

    {
      underReviewItems.length > 0 && (
        <section class="reviewing" aria-labelledby="reviewing-title">
          <p class="eyebrow">Not in the ranking</p>
          <h2 id="reviewing-title" class="reviewing-title">Under author review</h2>
          <p class="reviewing-dek">
            These grades are shown for transparency and listed A–Z. They do not enter the ranking
            until the author marks the review complete.
          </p>
          <ul class="ranked" aria-label={`Remedies for ${outcome.title} under author review`}>
            {underReviewItems.map((r) => (
              <li>
                <a class="row" href={`/r/${r.slug}`}>
                  <span class="idx" aria-hidden="true">—</span>
                  <TierBadge tier={r.tier} size="card" />
                  <span class="row-main">
                    <span class="row-name">{r.name}</span>
                    <span class="row-note">{r.oneLiner}</span>
                  </span>
                  <span class="row-status">
                    <ReviewState state={r.workflowState} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- what we're measuring -->
    <section class="measuring">
      <p class="measuring-label">What we're measuring</p>
      <p class="measuring-body">{outcome.measuring}</p>
    </section>

    <!-- other goals -->
    <section class="section">
      <p class="eyebrow">Other goals</p>
      <div class="others">
        {
          others.map((o) => (
            <a class="other" href={`/outcome/${o.id}`}>
              <p class="other-title">{o.title}</p>
              <p class="other-dek">{o.dek}</p>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Base>

<style>
  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding: var(--sp-8) var(--sp-7) var(--sp-9);
  }
  .dot {
    color: var(--primary);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    margin: 0;
  }
  .head {
    margin-bottom: var(--sp-6);
  }
  .crumb {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    margin: 0 0 var(--sp-5);
  }
  .crumb a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumb a:hover {
    color: var(--ink);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-3xl);
    line-height: var(--lh-3xl);
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
    margin: var(--sp-3) 0 var(--sp-3);
  }
  .dek {
    font-size: var(--text-md);
    line-height: var(--lh-md);
    color: var(--muted);
    max-width: 64ch;
    margin: 0;
  }

  /* goal switcher chips */
  .switcher {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-6) 0 var(--sp-7);
  }
  .chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    background: var(--surface);
    border: var(--border-hairline);
    border-radius: var(--r-pill);
    padding: var(--sp-2) var(--sp-4);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-soft);
  }
  .chip:hover {
    border-color: var(--mineral);
  }
  .chip.active {
    color: var(--ink);
    background: var(--primary-soft);
    border-color: var(--primary);
  }
  .chip:focus-visible {
    outline: none;
    box-shadow: var(--ring);
  }

  /* ranked list */
  .ranked {
    list-style: none;
    margin: 0;
    padding: 0;
    border: var(--border-hairline);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .ranked li + li .row {
    border-top: var(--border-hairline);
  }
  .row {
    display: grid;
    grid-template-columns: 44px 44px 1fr auto;
    gap: var(--sp-4);
    align-items: center;
    padding: var(--sp-4) var(--sp-5);
    text-decoration: none;
    color: var(--ink);
    background: var(--surface);
    transition: background var(--dur-fast) var(--ease-soft);
  }
  .row:hover {
    background: var(--stone);
  }
  .row:focus-visible {
    outline: none;
    box-shadow: var(--ring);
  }
  .idx {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .row-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .row-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.1;
    color: var(--ink);
  }
  .row-note {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: var(--muted);
  }
  .row-grade {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    white-space: nowrap;
  }
  .row-status {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--sp-1);
  }
  .ranking-empty {
    margin: 0;
    padding: var(--sp-6);
    background: var(--surface);
    border: var(--border-hairline);
    border-radius: var(--r-lg);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    text-align: center;
  }
  .reviewing {
    margin-top: var(--sp-8);
  }
  .reviewing-title {
    margin: var(--sp-2) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--lh-xl);
    color: var(--ink);
  }
  .reviewing-dek {
    max-width: 66ch;
    margin: var(--sp-3) 0 var(--sp-5);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
  }

  /* what we're measuring */
  .measuring {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--sp-5);
    margin-top: var(--sp-8);
    padding: var(--sp-6);
    background: var(--surface);
    border: var(--border-hairline);
    border-radius: var(--r-lg);
  }
  .measuring-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    margin: 0;
  }
  .measuring-body {
    font-size: var(--text-base);
    line-height: var(--lh-base);
    color: var(--muted);
    margin: 0;
    max-width: 66ch;
  }

  /* other goals */
  .section {
    margin-top: var(--sp-8);
  }
  .others {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
    margin-top: var(--sp-5);
  }
  .other {
    background: var(--surface);
    border: var(--border-hairline);
    border-radius: var(--r-lg);
    padding: var(--sp-5);
    text-decoration: none;
    color: var(--ink);
    transition:
      box-shadow var(--dur-base) var(--ease-settle),
      transform var(--dur-base) var(--ease-settle);
  }
  .other:hover {
    box-shadow: var(--shadow-lift);
    transform: translateY(-3px);
  }
  .other:focus-visible {
    outline: none;
    box-shadow: var(--ring);
  }
  .other-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--ink);
    margin: 0 0 var(--sp-2);
  }
  .other-dek {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: var(--muted);
    margin: 0;
  }

  @media (max-width: 760px) {
    .others {
      grid-template-columns: 1fr;
    }
    .measuring {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
    }
  }
  @media (max-width: 640px) {
    .page {
      padding: var(--sp-6) var(--sp-5) var(--sp-8);
    }
    .title {
      font-weight: 700;
      font-size: var(--text-2xl);
    }
    .row {
      grid-template-columns: 32px 38px 1fr;
    }
    .row-grade {
      display: none;
    }
    .row-status {
      grid-column: 3;
      align-items: flex-start;
    }
  }
</style>
