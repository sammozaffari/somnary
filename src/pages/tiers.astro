---
// Remedies overview — the Evidence × Safety MAP (replaces the old S–F leaderboard).
// The 1-D ranking led with the two owner-ratified grades (a D and an F) and buried the
// rest, and a single letter conflated "how sure are we", "how much does it do", and
// "how safe is it". The map plots every remedy by two orthogonal axes — evidence
// strength (X) and safety risk (Y) — with effect reality left in each card's own
// verdict line. Grades are unchanged and human-gated; the map only re-presents them.
//
// Server-rendered/static and crawlable: the map is real HTML, and the flat A–Z-within-
// grade <ul> below it is the canonical, JS-off-safe substrate. Nothing here re-derives
// or edits a grade.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import RemedyCard from '../components/RemedyCard.astro';
import Disclaimer from '../components/Disclaimer.astro';
import EvidenceMap, { type MapNode } from '../components/EvidenceMap.astro';
import { TIERS, type TierId } from '../lib/tiers';
import { contentIndex } from '../lib/content-index';
import { placeOnMap } from '../lib/evidence-map';
import { isDefaultRankingEligible, isOrdinarySearchEligible } from '../lib/remedy-state';

// Category is a nav/filter facet that lives in the content-index store (already imported
// here); the remedy content schema carries no `category` field, so we read it by slug
// rather than add a schema field (a schema change is a [HUMAN-GATE]). No content is
// duplicated — this reads the one existing registry.
const categoryOf = new Map(contentIndex.map((e) => [e.slug, e.category]));

const remedies = await getCollection(
  'remedies',
  (e) => !e.data.draft && isOrdinarySearchEligible(e.data),
);

// One node per remedy: existing fields → map placement. `ratified` drives the review
// TEXTURE only (solid vs dashed) — never position or prominence.
const nodes: MapNode[] = remedies.map((e) => {
  const { evidenceBand, safetyBand } = placeOnMap({
    tier: e.data.tier,
    severity: e.data.safety.severity,
    interactionCount: e.data.safety.interactions.length,
  });
  return {
    slug: e.id,
    name: e.data.name,
    tier: e.data.tier,
    workflowState: e.data.workflowState,
    oneLiner: e.data.oneLineVerdict,
    epistemicState: e.data.epistemicState,
    category: categoryOf.get(e.id) ?? '',
    evidenceBand,
    safetyBand,
    ratified: isDefaultRankingEligible(e.data),
  };
});

// Crawlable substrate: ALL remedies in canonical grade(S→F)→name(A–Z) order. This flat
// list is the JS-off-safe, accessible reading path beneath the map.
const rankOf = new Map<TierId, number>(TIERS.map((t, i) => [t.id, i]));
const orderedNodes = [...nodes].sort(
  (a, b) => rankOf.get(a.tier)! - rankOf.get(b.tier)! || a.name.localeCompare(b.name),
);

// Category facets for the map-filter island (progressive enhancement only).
const categories = [...new Set(nodes.map((n) => n.category).filter(Boolean))].sort();
const ratifiedCount = nodes.filter((n) => n.ratified).length;
---

<Base
  title="Somnary remedy evidence map — evidence strength × safety"
  description="Every natural sleep remedy mapped by two things at once: how strong the published human evidence is, and how risky it is. Grades are the author's; each card says how much the remedy actually does."
  canonical="https://somnary.vercel.app/tiers"
>
  <main class="page">
    <header class="head">
      <p class="eyebrow">Remedies · Reference overview</p>
      <h1 class="title">The remedy evidence map</h1>
      <p class="dek">
        Every remedy plotted by two questions at once: <strong>how sure are we it works</strong>
        (left → right) and <strong>how risky is it</strong> (bottom → top). A single letter can’t
        say both — so the grade sets the horizontal position, safety sets the vertical, and each
        card’s own line tells you how much it actually does. All {nodes.length} remedies show;
        {ratifiedCount} carry a completed review (solid), the rest are still under the author’s
        review (dashed).
      </p>
      <Disclaimer variant="compact" />
    </header>

    <!-- category filter — progressive enhancement; dims non-matching nodes/rows IN PLACE -->
    <div class="controls">
      <span id="filter-label" class="controls-label">Filter by category</span>
      <div class="segmented" role="group" aria-labelledby="filter-label">
        <button type="button" class="seg" data-filter="all" aria-pressed="true">All</button>
        {
          categories.map((c) => (
            <button type="button" class="seg" data-filter={c} aria-pressed="false">
              {c}
            </button>
          ))
        }
      </div>
      <a class="compare-link" href="/compare">Compare remedies side by side →</a>
    </div>

    <EvidenceMap nodes={nodes} />

    <!-- crawlable substrate: ALL remedies, grade(S→F)→name(A–Z). JS-off-safe canonical content. -->
    <section class="substrate" aria-labelledby="all-remedies-title">
      <div class="section-head">
        <div>
          <p class="eyebrow">The full list</p>
          <h2 id="all-remedies-title" class="section-title">Every remedy, A–Z within grade</h2>
        </div>
        <p class="section-count">{orderedNodes.length} remedies</p>
      </div>
      <ul id="remedy-grid" class="grid">
        {
          orderedNodes.map((n) => (
            <li class="cell" data-category={n.category}>
              <RemedyCard
                slug={n.slug}
                name={n.name}
                tier={n.tier}
                workflowState={n.workflowState}
                oneLiner={n.oneLiner}
              />
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Base>

<script>
  // Map-filter island — progressive enhancement only. Clicking a category dims the
  // non-matching map chips AND substrate rows IN PLACE (opacity), never removing them
  // from the DOM. With JS off, every node/row is present and undimmed — the map + full
  // list stand as the content. Stateless; "All" clears the dim. No layout reflow, so
  // prefers-reduced-motion is honored by construction.
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.seg[data-filter]'));
  const targets = Array.from(document.querySelectorAll<HTMLElement>('[data-category]'));
  if (buttons.length && targets.length) {
    const apply = (filter: string) => {
      for (const el of targets) {
        const match = filter === 'all' || el.dataset.category === filter;
        el.classList.toggle('is-dimmed', !match);
      }
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
    };
    for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.filter ?? 'all'));
  }
</script>

<style>
  .page {
    max-width: 1240px;
    margin: 0 auto;
    padding: var(--sp-8) var(--sp-7) var(--sp-9);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    margin: 0;
  }
  .head {
    margin-bottom: var(--sp-6);
  }
  .dek strong {
    color: var(--ink);
    font-weight: 650;
  }
  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-3xl);
    line-height: var(--lh-3xl);
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
    margin: var(--sp-3) 0 var(--sp-4);
  }
  .dek {
    font-size: var(--text-md);
    line-height: var(--lh-md);
    color: var(--muted);
    max-width: 70ch;
    margin: 0;
  }

  /* category filter control */
  .controls {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
    flex-wrap: wrap;
  }
  .compare-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--primary);
    text-decoration: none;
    margin-left: auto;
    transition: color var(--dur-fast) var(--ease-soft);
  }
  .compare-link:hover {
    color: var(--primary-deep);
  }
  .compare-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--r-xs);
  }
  .controls-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
  }
  .segmented {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--sp-1);
    padding: var(--sp-1);
    background: var(--surface);
    border: var(--border-hairline);
    border-radius: var(--r-lg);
  }
  .seg {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;  /* Instrument Sans caps at 700 (T-01) */
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    background: transparent;
    border: none;
    border-radius: var(--r-pill);
    padding: var(--sp-2) var(--sp-4);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-soft),
      background var(--dur-fast) var(--ease-soft);
  }
  .seg:hover {
    color: var(--ink);
  }
  .seg[aria-pressed='true'] {
    color: var(--surface);
    background: var(--primary);
  }
  .seg:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* canonical flat grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--sp-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cell {
    display: flex;
  }
  .cell > :global(.card) {
    width: 100%;
  }
  /* filter island: dim non-matching nodes/rows in place (never removed from DOM) */
  :global(.is-dimmed) {
    opacity: 0.28;
    transition: opacity var(--dur-fast) var(--ease-soft);
  }
  .substrate {
    margin-top: var(--sp-9);
    padding-top: var(--sp-7);
    border-top: var(--border-strong);
  }
  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--sp-5);
    flex-wrap: wrap;
  }
  .section-title {
    margin: var(--sp-2) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--lh-xl);
    color: var(--ink);
  }
  .section-count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .page {
      padding: var(--sp-6) var(--sp-5) var(--sp-8);
    }
    .title {
      font-weight: 700;
      font-size: var(--text-2xl);
    }
    .controls {
      align-items: flex-start;
    }
    .compare-link {
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.is-dimmed) {
      transition: none;
    }
  }
</style>
