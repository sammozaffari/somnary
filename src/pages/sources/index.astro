---
import Base from '../../layouts/Base.astro';
import { MAGNESIUM_SOURCES } from '../../data/source-scorecards/magnesium';
import { ASHWAGANDHA_SOURCES } from '../../data/source-scorecards/ashwagandha';
import { GLYCINE_SOURCES } from '../../data/source-scorecards/glycine';
import { VALERIAN_SOURCES } from '../../data/source-scorecards/valerian';
import { MELATONIN_SOURCES } from '../../data/source-scorecards/melatonin';

const reviewDate = '2026-07-27';

// Counts stay accurate because they're derived from the same data the pages render.
const remedies = [
  {
    slug: 'magnesium',
    name: 'Magnesium',
    count: MAGNESIUM_SOURCES.filter((p) => p.ratified).length,
    blurb: 'Which brands disclose how much of each form is inside — and which add the vitamin B6 the TGA is acting on.',
  },
  {
    slug: 'ashwagandha',
    name: 'Ashwagandha',
    count: ASHWAGANDHA_SOURCES.filter((p) => p.ratified).length,
    blurb: 'Named clinical extract or generic? Root-only or the leaf under liver scrutiny? Who prints the withanolide figure.',
  },
  {
    slug: 'valerian',
    name: 'Valerian',
    count: VALERIAN_SOURCES.filter((p) => p.ratified).length,
    blurb: 'Standardised to valerenic acid, or trusting the brand? Which carry Australia’s liver-caution warning.',
  },
  {
    slug: 'glycine',
    name: 'Glycine',
    count: GLYCINE_SOURCES.filter((p) => p.ratified).length,
    blurb: 'Does a serving actually reach the studied ~3 g? Who publishes a lab report, and who’s a food not a medicine.',
  },
  {
    slug: 'melatonin',
    name: 'Melatonin',
    count: MELATONIN_SOURCES.filter((p) => p.ratified && p.availableInAU !== false).length,
    note: 'Prescription-only in Australia',
    blurb: 'Independent testing keeps finding melatonin label amounts far off from what’s inside — which imports actually verify it.',
  },
];
---

<Base
  title="Source scorecards — where to buy sleep supplements — Somnary"
  description="Documented source scorecards for natural sleep supplements sold in Australia — magnesium, ashwagandha, valerian, glycine, melatonin. Which brands actually disclose what's in the bottle and don't overstate it, rated on six documented dimensions. No composite score, no #1, no affiliate links, ever."
>
  <main class="page">
    <header class="head">
      <p class="eyebrow">Somnary</p>
      <h1 class="title">Source scorecards</h1>
      <p class="dek">
        The <a href="/tiers">evidence grades</a> answer whether a remedy helps you sleep. This section
        answers the next question: <strong>of the products you can actually buy, which brands disclose
        what’s in the bottle and don’t overstate it?</strong> Every product is rated on six documented
        dimensions, each score explained in a written note that shows its basis. No overall score, no #1, and
        <strong>no affiliate links, ever</strong> — Somnary earns nothing if you buy.
      </p>
    </header>

    <section class="grid" aria-label="Source scorecards by remedy">
      {
        remedies.map((r) => (
          <a class="card" href={`/sources/${r.slug}`}>
            <div class="card-head">
              <h2 class="card-title">{r.name}</h2>
              <span class="card-count">{r.count} products</span>
            </div>
            {r.note ? <p class="card-note">{r.note}</p> : null}
            <p class="card-blurb">{r.blurb}</p>
            <span class="card-go">See the scorecard →</span>
          </a>
        ))
      }
    </section>

    <section class="more" aria-label="More">
      <a class="more-link" href="/sources/additives">
        <span class="more-title">What we watch for in the ingredients list →</span>
        <span class="more-sub">The cited additive watchlist behind the Additives score — in plain words, with the label synonyms to spot.</span>
      </a>
      <a class="more-link" href="/sources/methodology">
        <span class="more-title">How we rate →</span>
        <span class="more-sub">The six dimensions, the point rules, and why we never publish an unverified negative about a brand.</span>
      </a>
    </section>

    <p class="footer-strip">
      Somnary · Source scorecards · Reviewed {reviewDate} · Educational, not medical advice · These pages
      rate how a product is sourced and labeled — never whether you should take it. Found an error, or a
      brand with a document to add? We aim to fix verified errors within 7 days —
      <a href="mailto:sammymoz@gmail.com">sammymoz@gmail.com</a>.
    </p>
  </main>
</Base>

<style>
  .page {
    max-width: 940px;
    margin: 0 auto;
    padding: var(--sp-8) var(--sp-7) var(--sp-9);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    margin: 0;
  }
  .head {
    margin-bottom: var(--sp-8);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-3xl);
    line-height: var(--lh-3xl);
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
    margin: var(--sp-2) 0 0;
  }
  .dek {
    font-size: var(--text-md);
    line-height: var(--lh-md);
    color: var(--ink);
    margin: var(--sp-4) 0 0;
    max-width: 72ch;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-5);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    border: var(--border-hairline);
    border-radius: var(--r-xl);
    background: var(--surface);
    padding: var(--sp-5) var(--sp-6);
    text-decoration: none;
    color: var(--ink);
  }
  .card:hover {
    border-color: var(--primary);
  }
  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3);
    min-width: 0;
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-xl);
    line-height: var(--lh-xl);
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
    margin: 0;
    min-width: 0;
  }
  .card-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    white-space: nowrap;
  }
  .card-note {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--safety-ink, var(--muted));
    margin: 0;
  }
  .card-blurb {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: var(--muted);
    margin: var(--sp-1) 0 0;
    flex: 1 1 auto;
  }
  .card-go {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--primary);
    margin-top: var(--sp-3);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-5);
    margin-top: var(--sp-6);
  }
  @media (max-width: 560px) {
    .more {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .more-link {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    border: var(--border-hairline);
    border-left: 3px solid var(--primary);
    border-radius: var(--r-lg);
    background: var(--primary-soft);
    padding: var(--sp-5) var(--sp-6);
    text-decoration: none;
  }
  .more-link:hover {
    border-color: var(--primary);
    border-left-color: var(--primary);
  }
  .more-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-md);
    line-height: var(--lh-md);
    color: var(--ink);
  }
  .more-sub {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: var(--muted);
  }

  .footer-strip {
    margin-top: var(--sp-8);
    padding-top: var(--sp-5);
    border-top: var(--border-hairline);
    font-size: var(--text-xs);
    line-height: var(--lh-sm);
    color: var(--muted);
  }
  .footer-strip a {
    color: var(--primary);
  }
</style>
