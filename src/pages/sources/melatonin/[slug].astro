---
import Base from '../../../layouts/Base.astro';
import ProductPage from '../../../components/scorecards/ProductPage.astro';
import { MELATONIN_SOURCES, type SourceProduct } from '../../../data/source-scorecards/melatonin';
import { toMelCard as toCard } from '../../../lib/sources/cards';
import { computeTier, TIERS } from '../../../data/source-scorecards/tiers';

export function getStaticPaths() {
  return MELATONIN_SOURCES.filter((p) => p.ratified && p.availableInAU !== false).map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props as { product: SourceProduct };
const card = toCard(product);
const tier = TIERS[computeTier(product.scores, card.hasB6)];
const retailerNote = 'Reminder: melatonin is a prescription medicine in Australia — these are personal imports. Talk to a doctor or pharmacist first (Circadin is the local pharmacy option).';
---

<Base
  title={`${card.brand} ${card.productName} — Melatonin source scorecard — Somnary`}
  description={card.bottomLine}
>
  <ProductPage
    card={card}
    tier={tier}
    remedy={{ name: 'Melatonin', slug: 'melatonin' }}
    retailers={product.retailers}
    ingredients={product.ingredients}
    retailerNote={retailerNote ?? undefined}
    reviewDate="2026-07-19"
  />
</Base>
