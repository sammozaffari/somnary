---
// Base document layout. Imports the global stylesheet (design-system tokens, both themes)
// and self-hosts Onest. Server-rendered shell so content is crawlable from day one.
// Type: Onest — ONE self-hosted family (RULES.md Identity; CHK-B1). The woff2 live in
// public/fonts/, declared with a local @font-face in global.css and preloaded below; NO
// Google Fonts / Fontshare / third-party font CDN (verify:fonts). The Instrument Sans
// @fontsource import was removed with the CHK-B1 type swap.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Crumb {
  label: string;
  href: string;
}
interface Props {
  title: string;
  description?: string;
  canonical?: string; // per-page canonical URL (SEO furniture — first used by remedy pages, CHK-2.1)
  ogType?: string; // open-graph type: 'website' (default) or 'article' for remedy pages (CHK-2.2)
  ogImage?: string; // absolute URL to a per-page OG image (remedy pages generate one, CHK-2.2)
  // Breadcrumbs are the back affordance (RULES.md) — pass the parent trail + current label and
  // Base renders them at the top of <main>. Root/home omits them (root exempt). Pages may also
  // render <Breadcrumb> themselves; this prop is the shell convenience.
  breadcrumbs?: Crumb[];
  breadcrumbCurrent?: string;
  // contain=true wraps the slot in the --page-max content column with page padding. Pages that
  // manage their own full-bleed layout pass contain={false}.
  contain?: boolean;
}
const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage,
  breadcrumbs,
  breadcrumbCurrent,
  contain = true,
} = Astro.props;

// Every page gets a share card: remedy pages pass their own generated og:image; everything else
// falls back to the site-wide branded default at /og.png (see src/pages/og.png.ts). Absolute URL
// per the OG spec — derived from Astro.site so previews don't render an imageless `summary` card.
const site = Astro.site?.href?.replace(/\/$/, '') ?? 'https://somnary.vercel.app';
const ogImageUrl = ogImage ?? `${site}/og.png`;

// CANONICAL ON EVERY PAGE, DERIVED (CHK-B16). It used to be an optional prop no page passed, so
// the site shipped none. Deriving it here means it cannot be forgotten on a new page — the one
// place it can go wrong is a page that genuinely needs a different canonical, which passes the
// prop. Query strings are dropped (/search?q=x must not canonicalise to itself as a new page)
// and the trailing slash is normalised so /remedies and /remedies/ never compete.
const canonicalUrl =
  canonical ?? `${site}${Astro.url.pathname.replace(/\/+$/, '') || '/'}`;

// JSON-LD, and ONLY where it is honest (CHK-B16). The site publishes no ratings, so it emits NO
// Product, Review or AggregateRating markup — that is precisely the score this site refuses to
// have, and emitting it for search engines while refusing it on the page would be a lie told to
// a machine. What is honest: what the site IS, and how to search it.
const isHome = Astro.url.pathname === '/';
const jsonLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Somnary',
      url: `${site}/`,
      description:
        'An independent reference for natural sleep remedies: whether the research says they work, and whether the bottle delivers what was studied.',
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${site}/search?q={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    }
  : null;

const showCrumbs = breadcrumbs && breadcrumbCurrent;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />

    {/* THEME (CHK-B15, amended by owner 20 August 2026: **light is the standard**).
        This script is FIRST in <head> and inline for one reason: it must resolve the theme
        before the browser paints, or you get the flash of the wrong theme.

        THE RULE IS NOW DELIBERATELY SIMPLE — day unless the reader has chosen night.
        The previous version consulted `prefers-color-scheme` and then the clock, which meant
        anyone on a dark-mode machine got the night theme at every hour and never saw the light
        design at all. Sunset keying is RETIRED with it: a theme that flips itself at 19:00
        contradicts "light is the standard", and a page that changes appearance on its own
        between two visits is surprising more than it is clever.

        `dusk` is the only value ever written, so a stale or corrupt stored value can never
        leave the page in an undefined theme — anything that isn't exactly 'dusk' is day. */}
    <script is:inline>
      (() => {
        try {
          if (localStorage.getItem('somnary-theme') === 'dusk')
            document.documentElement.setAttribute('data-theme', 'dusk');
        } catch (e) {
          /* private mode, blocked storage, anything — day is the standard and needs no attribute */
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Identity — the letterform-"S" mark (RULES.md Identity: the mark is the letterform S,
        no moons/stars/sleep costume; the crescent-moon disc + dot-field favicon are retired,
        CHK-B1). SVG favicons render without the page's fonts, so the assets are OUTLINED PATHS
        (extracted from Onest 600), never live <text>. Day/dusk favicon variants via media. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dusk.svg" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* theme-color is a browser-chrome hint (HTML attr, not CSS) — it cannot read a token, so it
        must be a literal. These mirror --paper (day) and dusk --paper. */}
    {/* raw-ok: theme-color literal = --paper (day ground) */}
    <meta name="theme-color" content="#F6F2E9" media="(prefers-color-scheme: light)" />
    {/* raw-ok: theme-color literal = dusk --paper (night ground) */}
    <meta name="theme-color" content="#17151E" media="(prefers-color-scheme: dark)" />

    {/* Self-hosted Onest — preload the primary latin subset (the one weights-axis file that
        carries every --weight-* token); latin-ext loads on demand. No font CDN (verify:fonts). */}
    <link
      rel="preload"
      href="/fonts/onest-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />

    {/* Open Graph / Twitter (CHK-2.2). Remedy pages pass a generated og:image; every other page
        falls back to the site-wide branded default (ogImageUrl), so no page ships an imageless card. */}
    <meta property="og:site_name" content="Somnary" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main-content" tabindex="-1" class:list={[contain && 'contain']}>
      {showCrumbs && <Breadcrumb trail={breadcrumbs!} current={breadcrumbCurrent!} />}
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* A-03: skip-to-content bypass — the first focusable element on every route, so a keyboard
     user can jump past the repeated nav straight to #main-content (RULES.md a11y: keyboard
     access). Off-screen until focused, then it slides in as a solid pill — never a hidden trap. */
  .skip-link {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 200;
    padding: var(--space-3) var(--space-4);
    background: var(--ink);
    color: var(--paper); /* light-on-ink */
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transform: translateY(calc(-100% - var(--space-7)));
    transition: transform var(--dur-fast) var(--ease-fade);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  /* the main landmark takes programmatic focus from the skip link but must not paint its own ring */
  #main-content:focus {
    outline: none;
  }
  /* default content column — the single-column reading width (--page-max), with page padding.
     Pages that manage a full-bleed layout opt out with contain={false}. */
  .contain {
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--space-5) var(--space-9);
  }
  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
</style>
