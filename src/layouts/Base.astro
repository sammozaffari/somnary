---
// Base document layout. Imports the global stylesheet (Tailwind layers + DESIGN_SYSTEM
// tokens) and self-hosts the brand typefaces (DESIGN_SYSTEM v3 §2). Server-rendered
// shell so content is crawlable from day one.
// Typefaces (self-hosted via @fontsource — no CDN): Instrument Sans (variable weight
// axis) for everything. IBM Plex Mono retired 2026-07-09 (owner) — the mono font is gone
// site-wide; --font-mono now aliases Instrument Sans (see global.css).
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string; // per-page canonical URL (SEO furniture — first used by remedy pages, CHK-2.1)
  ogType?: string; // open-graph type: 'website' (default) or 'article' for remedy pages (CHK-2.2)
  ogImage?: string; // absolute URL to a per-page OG image (remedy pages generate one, CHK-2.2)
}
const { title, description, canonical, ogType = 'website', ogImage } = Astro.props;

// Every page gets a share card: remedy pages pass their own generated og:image; everything else
// falls back to the site-wide branded default at /og.png (see src/pages/og.png.ts). Absolute URL
// per the OG spec — derived from Astro.site so previews don't render an imageless `summary` card.
const site = Astro.site?.href?.replace(/\/$/, '') ?? 'https://somnary.vercel.app';
const ogImageUrl = ogImage ?? `${site}/og.png`;

// Search-first IA (2026-07-27, Phase 1): a global "Back" affordance on every interior page (not the
// homepage). The anchor points at "/" so it works with JS disabled / no history (no-referrer fallback);
// the inline script upgrades it to history.back() when there is somewhere to go back to.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = path === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}

    {/* Open Graph / Twitter (CHK-2.2). Remedy pages pass a generated og:image; every other page
        falls back to the site-wide branded default (ogImageUrl), so no page ships an imageless card. */}
    <meta property="og:site_name" content="Somnary" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Brand typefaces are self-hosted via @fontsource (imported in the frontmatter,
        bundled by Astro) — DESIGN_SYSTEM v3 §2: Instrument Sans display+body, IBM Plex
        Mono for data. No Google Fonts CDN. */}
  </head>
  <body>
    <Nav />
    {
      !isHome && (
        <div class="backbar">
          <a href="/" class="backlink" data-back>
            <span aria-hidden="true">←</span> Back
          </a>
        </div>
      )
    }
    <slot />
    <Footer />
    <script>
      // Upgrade the "Back" link to history.back() when there is history to return to; otherwise the
      // anchor's href="/" is the graceful fallback (works with JS off or when opened in a fresh tab).
      const back = document.querySelector('[data-back]');
      if (back && window.history.length > 1) {
        back.addEventListener('click', (event) => {
          event.preventDefault();
          window.history.back();
        });
      }
    </script>
  </body>
</html>

<style>
  .backbar {
    padding: var(--sp-4) var(--sp-7) 0;
  }
  /* muted-but-legible per the design doc: resting --muted, hover --ink. Tokens only. */
  .backlink {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-soft);
  }
  .backlink:hover {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .backbar {
      padding: var(--sp-4) var(--sp-5) 0;
    }
  }
</style>
