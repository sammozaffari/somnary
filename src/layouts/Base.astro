---
// Base document layout. Imports the global stylesheet (design-system tokens, both themes)
// and self-hosts Onest. Server-rendered shell so content is crawlable from day one.
// Type: Onest — ONE self-hosted family (RULES.md Identity; CHK-B1). The woff2 live in
// public/fonts/, declared with a local @font-face in global.css and preloaded below; NO
// Google Fonts / Fontshare / third-party font CDN (verify:fonts). The Instrument Sans
// @fontsource import was removed with the CHK-B1 type swap.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string; // per-page canonical URL (SEO furniture — first used by remedy pages, CHK-2.1)
  ogType?: string; // open-graph type: 'website' (default) or 'article' for remedy pages (CHK-2.2)
  ogImage?: string; // absolute URL to a per-page OG image (remedy pages generate one, CHK-2.2)
}
const { title, description, canonical, ogType = 'website', ogImage } = Astro.props;

// Every page gets a share card: remedy pages pass their own generated og:image; everything else
// falls back to the site-wide branded default at /og.png (see src/pages/og.png.ts). Absolute URL
// per the OG spec — derived from Astro.site so previews don't render an imageless `summary` card.
const site = Astro.site?.href?.replace(/\/$/, '') ?? 'https://somnary.vercel.app';
const ogImageUrl = ogImage ?? `${site}/og.png`;

// Search-first IA (2026-07-27, Phase 1): a global "Back" affordance on every interior page (not the
// homepage). The anchor points at "/" so it works with JS disabled / no history (no-referrer fallback);
// the inline script upgrades it to history.back() when there is somewhere to go back to.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = path === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Identity — the letterform-"S" mark (RULES.md Identity: the mark is the letterform S,
        no moons/stars/sleep costume; the crescent-moon disc + dot-field favicon are retired,
        CHK-B1). SVG favicons render without the page's fonts, so the assets are OUTLINED PATHS
        (extracted from Onest 600), never live <text>. Day/dusk favicon variants via media. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dusk.svg" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* theme-color is a browser-chrome hint (HTML attr, not CSS) — it cannot read a token, so it
        must be a literal. These mirror --paper (day) and dusk --paper. */}
    {/* raw-ok: theme-color literal = --paper (day ground) */}
    <meta name="theme-color" content="#F6F2E9" media="(prefers-color-scheme: light)" />
    {/* raw-ok: theme-color literal = dusk --paper (night ground) */}
    <meta name="theme-color" content="#17151E" media="(prefers-color-scheme: dark)" />

    {/* Self-hosted Onest — preload the primary latin subset (the one weights-axis file that
        carries every --weight-* token); latin-ext loads on demand. No font CDN (verify:fonts). */}
    <link
      rel="preload"
      href="/fonts/onest-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}

    {/* Open Graph / Twitter (CHK-2.2). Remedy pages pass a generated og:image; every other page
        falls back to the site-wide branded default (ogImageUrl), so no page ships an imageless card. */}
    <meta property="og:site_name" content="Somnary" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Nav />
    {
      !isHome && (
        <div class="backbar">
          <a href="/" class="backlink" data-back>
            <span aria-hidden="true">←</span> Back
          </a>
        </div>
      )
    }
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <Footer />
    <script>
      // Upgrade the "Back" link to history.back() when there is history to return to; otherwise the
      // anchor's href="/" is the graceful fallback (works with JS off or when opened in a fresh tab).
      const back = document.querySelector('[data-back]');
      if (back && window.history.length > 1) {
        back.addEventListener('click', (event) => {
          event.preventDefault();
          window.history.back();
        });
      }
    </script>
  </body>
</html>

<style>
  /* A-03: skip-to-content bypass. First focusable element on every route, so a keyboard user
     can jump past the repeated global nav (and back bar) straight to #main-content. Off-screen
     until focused, then it slides into the top-left as a solid pill — never a hidden focus trap. */
  .skip-link {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    z-index: 200;
    padding: var(--sp-3) var(--sp-4);
    background: var(--ink);
    color: var(--paper); /* light-on-ink — retired --action-ink removed at CHK-B1 (Base is rebuilt at B2) */
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-decoration: none;
    border-radius: var(--r-sm);
    transform: translateY(calc(-100% - var(--sp-6)));
    transition: transform var(--dur-fast) var(--ease-soft);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  /* the focus target must not paint its own outline/ring when focused programmatically */
  #main-content:focus {
    outline: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }

  .backbar {
    padding: var(--sp-4) var(--sp-7) 0;
  }
  /* muted-but-legible per the design doc: resting --muted, hover --ink. Tokens only. */
  .backlink {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-soft);
  }
  .backlink:hover {
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .backbar {
      padding: var(--sp-4) var(--sp-5) 0;
    }
  }
</style>
