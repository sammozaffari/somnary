---
// Footer (app-shell) — CHK-B2, transcribed from the bundle chrome (HomePage footer +
// DisclaimerBand). RULES.md Language: the independence claim is ONE quiet line — exactly this
// sentence, never the self-congratulating stat row or any banned phrase ("reader-funded",
// "zero brand money", "evidence-graded" …). RULES.md Interface economy: How-we-grade is NOT in
// the nav — it is reached from every bucket badge and HERE. The "last updated {date}" tag is a
// CHK-B17 freshness concern (real date, rendered "14 July 2026") — omitted here rather than
// invent a date (RULES.md: never invent a number). Interface colour is --ink (no accent).
import DisclaimerBand from './DisclaimerBand.astro';
---

<footer class="footer">
  <div class="inner">
    <p class="independence">
      Nobody pays us to say any of this. Every claim links to the study it came from.
    </p>
    <div class="meta">
      <a href="/how-we-grade">How we grade</a>
      {/* The theme control lives HERE, quietly, and not in the chrome: the theme follows the
          clock on its own (CHK-B15), so this is the override for the minority who want to
          countermand it — not a feature to advertise. Rendered hidden and revealed by the
          script below, because a control that cannot work without JS should not be painted. */}
      <button type="button" class="theme" data-theme-toggle hidden aria-pressed="false">
        <span data-theme-label>Night colours</span>
      </button>
    </div>
  </div>
  <DisclaimerBand />
</footer>

<script>
  // Theme override (CHK-B15). The resolved theme is already applied by the inline head script;
  // this only lets a reader countermand it and remembers the choice. Writing 'day' explicitly
  // matters — it is what stops the clock from flipping the page back at 19:00.
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (btn) {
    const label = btn.querySelector('[data-theme-label]')!;
    const isDusk = () => document.documentElement.getAttribute('data-theme') === 'dusk';
    const sync = () => {
      const dusk = isDusk();
      btn.setAttribute('aria-pressed', String(dusk));
      // the label names what the control DOES, not the state it is in
      label.textContent = dusk ? 'Day colours' : 'Night colours';
    };
    btn.hidden = false; // it works, so it may now be seen
    sync();
    btn.addEventListener('click', () => {
      const next = isDusk() ? 'day' : 'dusk';
      if (next === 'dusk') document.documentElement.setAttribute('data-theme', 'dusk');
      else document.documentElement.removeAttribute('data-theme');
      try {
        localStorage.setItem('somnary-theme', next);
      } catch (e) {
        /* storage blocked — the toggle still works for this page view */
      }
      sync();
    });
  }
</script>

<style>
  .footer {
    border-top: var(--border-w) solid var(--border-hairline);
  }
  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-7) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .independence {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--text-body);
    max-width: var(--measure);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
  }
  /* RULES.md Accessibility floors: "Hit areas ≥ 44px regardless of visual size." These are
     standalone navigation links, not links inside a sentence, so the floor applies with no
     inline exemption — measured at 22px and floored under CHK-B6's touch-target pass. Type size
     is untouched; the row's own gap absorbs the taller box. */
  .meta a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-md);
    color: var(--text-muted);
    font-weight: var(--weight-ui);
    text-decoration: none;
  }
  .meta a:hover {
    color: var(--text-body);
    text-decoration: underline;
  }
  .theme {
    display: inline-flex;
    align-items: center;
    /* 44px hit floor (RULES.md a11y) */
    min-height: var(--control-md);
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-muted);
    font: var(--weight-ui) var(--text-sm) var(--font-sans);
    cursor: pointer;
  }
  .theme:hover {
    color: var(--text-body);
    text-decoration: underline;
  }
</style>
