---
// Footer (app-shell) — CHK-B2, transcribed from the bundle chrome (HomePage footer +
// DisclaimerBand). RULES.md Language: the independence claim is ONE quiet line — exactly this
// sentence, never the self-congratulating stat row or any banned phrase ("reader-funded",
// "zero brand money", "evidence-graded" …). RULES.md Interface economy: How-we-grade is NOT in
// the nav — it is reached from every bucket badge and HERE. The "last updated {date}" tag is a
// CHK-B17 freshness concern (real date, rendered "14 July 2026") — omitted here rather than
// invent a date (RULES.md: never invent a number). Interface colour is --ink (no accent).
import DisclaimerBand from './DisclaimerBand.astro';
---

<footer class="footer">
  <div class="inner">
    <p class="independence">
      Nobody pays us to say any of this. Every claim links to the study it came from.
    </p>
    <div class="meta">
      <a href="/how-we-grade">How we grade</a>
    </div>
  </div>
  <DisclaimerBand />
</footer>

<style>
  .footer {
    border-top: var(--border-w) solid var(--border-hairline);
  }
  .inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-7) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .independence {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--text-body);
    max-width: var(--measure);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
  }
  /* RULES.md Accessibility floors: "Hit areas ≥ 44px regardless of visual size." These are
     standalone navigation links, not links inside a sentence, so the floor applies with no
     inline exemption — measured at 22px and floored under CHK-B6's touch-target pass. Type size
     is untouched; the row's own gap absorbs the taller box. */
  .meta a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-md);
    color: var(--text-muted);
    font-weight: var(--weight-ui);
    text-decoration: none;
  }
  .meta a:hover {
    color: var(--text-body);
    text-decoration: underline;
  }
</style>
