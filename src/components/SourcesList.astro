---
// Sources — DESIGN_SYSTEM §4 block 9. The numbered footnote list; every entry resolves to a real
// PubMed / DOI / registry link via the shared builder (src/lib/cite.ts), the same mapping the
// CHK-0.5 resolver validates. Rendered server-side so all citation detail is in the HTML and
// crawlable even with JS off (the popover is progressive enhancement on top of this). No
// rel="sponsored" anywhere — independence non-negotiable.
import {
  sourceUrl,
  sourceIdLabel,
  sourceTypeLabel,
  sourceStrength,
  byStrength,
  type CiteSource,
} from '../lib/cite';

interface Props {
  sources: CiteSource[];
}
const { sources } = Astro.props;
// Strongest evidence first (audit DOM-1): a meta-analysis outranks an animal study. Each entry
// still shows its footnote number, so inline [n] cross-references resolve regardless of order.
const ordered = [...sources].sort(byStrength);
---

<ol class="sources">
  {
    ordered.map((s) => (
      <li id={`source-${s.n}`} class="source">
        <span class="num" aria-hidden="true">{s.n}</span>
        <div class="body">
          <p class="s-type">
            <span
              class="pip"
              data-tier={sourceStrength(s.type).tier}
              role="img"
              aria-label={`${sourceStrength(s.type).label} evidence`}
            >
              <span /><span /><span />
            </span>
            <span class="s-type-word">{sourceTypeLabel(s.type)}</span>
          </p>
          <p class="s-title">{s.title}</p>
          <p class="s-line">{s.sourceLine}</p>
          <p class="s-finding">{s.finding}</p>
          <a class="s-link" href={sourceUrl(s)} target="_blank" rel="noopener noreferrer">
            {sourceIdLabel(s)} ↗
          </a>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .sources {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }
  .source {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: var(--sp-4);
    padding-top: var(--sp-5);
    border-top: var(--border-hairline);
  }
  .source:first-child {
    border-top: none;
    padding-top: 0;
  }
  .num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .body {
    min-width: 0;
  }
  /* Type label was a flat --eucalyptus (green) on EVERY source — which read as "verified" on weak
     sources too (audit DOM-1). Now neutral, with the strength pip carrying the evidence weight. */
  .s-type {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    margin: 0 0 var(--sp-2);
  }
  /* Evidence-weight pip: 3 dots, filled-count = strength. Neutral ink (--raisin) NOT green — it
     shows how much evidence weight, never implies "verified/positive" (§10). Text label + the
     pip's role=img aria-label carry the meaning; the dots themselves are decorative. */
  .pip {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    flex: none;
  }
  .pip span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: 1px solid var(--mineral);
    background: transparent;
  }
  .pip[data-tier='strong'] span {
    background: var(--raisin);
    border-color: var(--raisin);
  }
  .pip[data-tier='moderate'] span:nth-child(-n + 2) {
    background: var(--raisin);
    border-color: var(--raisin);
  }
  .pip[data-tier='weak'] span:nth-child(1) {
    background: var(--raisin);
    border-color: var(--raisin);
  }
  .s-title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    line-height: var(--lh-lg);
    color: var(--ink);
    margin: 0 0 var(--sp-2);
  }
  .s-line {
    font-size: var(--text-sm);
    color: var(--muted);
    margin: 0 0 var(--sp-2);
  }
  .s-finding {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: var(--muted);
    margin: 0 0 var(--sp-3);
  }
  .s-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--primary);
    text-decoration: none;
  }
  .s-link:focus-visible {
    outline: none;
    box-shadow: var(--ring);
    border-radius: var(--r-sm);
  }
</style>
