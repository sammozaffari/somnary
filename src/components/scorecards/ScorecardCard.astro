---
import { DIMENSION_ORDER, DIMENSION_LABELS, type ScorecardCardData } from '../../data/source-scorecards/card';
import type { TierMeta } from '../../data/source-scorecards/tiers';

interface Props {
  card: ScorecardCardData;
  tier?: TierMeta;
  /** Product-page URL — when set, the whole card becomes a link (stretched-link pattern). */
  href?: string;
}
const { card: p, tier, href } = Astro.props;
---

<article class="card">
  <div class="shot">
    {tier && (
      <span class="tier-badge" data-tier={tier.key}>
        <span class="tier-badge-icon" aria-hidden="true">{tier.icon}</span>{tier.label}
      </span>
    )}
    {p.imagePath ? (
      <img src={p.imagePath} alt={`${p.brand} ${p.productName}`} loading="lazy" decoding="async" />
    ) : (
      <span class="shot-fallback" aria-hidden="true">{p.brand.charAt(0)}</span>
    )}
  </div>

  <div class="body">
    <div class="id">
      <h3 class="brand">{p.brand}</h3>
      <p class="product">{p.productName}</p>
      {p.specLines.map((s) => <p class="spec">{s}</p>)}
      <p class="meta">{p.metaLine}</p>
      <p class="cert" data-kind={p.certVerified ? 'yes' : 'none'}>{p.certSummary}</p>
    </div>

    <p class="bottomline">{p.bottomLine}</p>

    {p.chips.length > 0 && (
      <div class="chips">
        {p.chips.map((c) => (
          <span class="chip" data-kind={c.kind} title={c.note}>{c.label}</span>
        ))}
      </div>
    )}

    <p class="go">
      {href ? <a class="go-link" href={href} aria-label={`Full scorecard — ${p.brand} ${p.productName}${tier ? ` (${tier.label})` : ''}`}>Full scorecard →</a> : null}
    </p>
  </div>
</article>

<style>
  .card {
    position: relative; /* containing block for the stretched card link */
    display: flex;
    flex-direction: column;
    border: var(--border-hairline);
    border-radius: var(--r-xl);
    background: var(--surface);
    overflow: hidden;
    container-type: inline-size;
  }
  .shot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    background: var(--primary-soft);
    border-bottom: var(--border-hairline);
  }
  /* absolutely positioned so the box's aspect-ratio is authoritative — a photo and a
     lettered fallback tile always render at exactly the same size */
  .shot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--sp-5);
  }
  .shot-fallback {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-3xl);
    color: var(--primary);
  }

  /* tier verdict, so a card carries its rating standalone (EWG score-chip analog) */
  .tier-badge {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--ink);
    background: var(--surface);
    border: var(--border-hairline);
    border-left: 3px solid var(--muted);
    border-radius: var(--r-sm);
    padding: var(--sp-1) var(--sp-2);
  }
  .tier-badge[data-tier='well-documented'],
  .tier-badge[data-tier='reasonable'] {
    border-left-color: var(--eucalyptus, var(--primary));
  }
  .tier-badge[data-tier='heads-up'] {
    border-left-color: var(--safety-ink, var(--vermilion));
  }
  .tier-badge-icon {
    font-size: var(--text-xs);
  }

  .body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: var(--sp-5);
    flex: 1 1 auto;
  }
  .id {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-lg);
    line-height: var(--lh-lg);
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
    margin: 0;
  }
  .product {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: var(--ink);
    margin: 0;
  }
  .spec {
    font-size: var(--text-xs);
    line-height: var(--lh-sm);
    color: var(--muted);
    margin: 0;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    margin: 0;
  }
  .cert {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    margin: var(--sp-1) 0 0;
  }
  .cert[data-kind='yes'] {
    color: var(--eucalyptus, var(--primary));
  }
  .cert[data-kind='none'] {
    color: var(--muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    border-radius: var(--r-sm);
    padding: var(--sp-1) var(--sp-2);
    margin: 0;
    white-space: nowrap;
  }
  .chip[data-kind='good'] {
    color: var(--eucalyptus, var(--primary));
    border: 1px solid var(--eucalyptus, var(--primary));
  }
  .chip[data-kind='warn'] {
    color: var(--safety-ink, var(--ink));
    border: 1px solid var(--safety-ink, var(--muted));
  }

  /* the 2-second read — bold lead line */
  .bottomline {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--lh-base);
    font-weight: 600;
    color: var(--ink);
    margin: var(--sp-1) 0 0;
  }

  .go {
    border-top: var(--border-hairline);
    padding-top: var(--sp-3);
    margin: 0;
    margin-top: auto; /* pin to the bottom so it lines up across a row */
  }
  .go-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--primary);
    text-decoration: none;
  }
  /* stretched link — the entire card is clickable */
  .go-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card:has(.go-link):hover {
    border-color: var(--primary);
  }
</style>
