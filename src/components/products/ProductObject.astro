---
// ProductObject — the product tile. Replaces the bare brand-initial square that readers were
// reading as a broken image.
//
// THE HONEST POSITION ON PRODUCT PHOTOGRAPHY. Somnary holds **no product photography at all** and
// never has: `imageSrc` was a prop nothing ever passed. Real photographs would have to be
// licensed — a manufacturer's press image or a retailer's catalogue shot is their copyright, and
// scraping either would be both a legal problem and a promise we could not keep as products
// change. RULES.md anticipated exactly this: *"Placeholder imagery is the common case — a
// designed object (brand mark on sunken ground), never 'no photo' or broken-image."*
//
// So this is not a fallback waiting for a photo. It is the artwork, drawn from data we actually
// hold — and it now shows the **dose form**, which is a real fact about the product and the one
// a reader most wants at a glance: a gummy is not a capsule is not a powder. 36 of 93 products
// have a mapped `deliveryForm`; the other 57 are `needs-review`, and for those the object falls
// back to the brand letterform alone rather than inventing a shape. **Never draw a form we have
// not recorded** — a guessed silhouette is a claim about the product.
import { formLabel } from '../../lib/products/labels.ts';

interface Props {
  brand: string;
  /** the CONTROLLED-VOCABULARY form; null (needs-review) draws no shape, only the letterform */
  form?: string | null;
  size?: number;
  radius?: string;
}
const { brand, form = null, size = 104, radius = 'var(--radius-md)' } = Astro.props;
const initial = String(brand).trim().charAt(0).toUpperCase() || '?';
// what the object is showing, for assistive tech — the form when we know it, else nothing
// pretending to be a picture
const label = form ? `${formLabel(form)} — illustration, not a photograph` : null;
---

<span
  class="obj"
  style={`--obj-size:${size}px;--obj-radius:${radius}`}
  role={label ? 'img' : undefined}
  aria-label={label ?? undefined}
  aria-hidden={label ? undefined : 'true'}
>
  {/* The dose form, drawn at a fixed 48-unit viewBox and scaled by the tile. Stroke and fill are
      tokens, so the object re-themes with the page and never carries meaning colour — this is
      furniture, not data (RULES.md: colour means data). */}
  {form && (
    <svg class="shape" viewBox="0 0 48 48" width="100%" height="100%" aria-hidden="true">
      {form === 'tablet' && (
        <g>
          <circle cx="24" cy="24" r="13" class="fill" />
          <line x1="24" y1="12" x2="24" y2="36" class="score" />
        </g>
      )}
      {form === 'capsule' && (
        <g>
          <rect x="9" y="17" width="30" height="14" rx="7" class="fill" />
          <path d="M24 17 v14" class="score" />
        </g>
      )}
      {form === 'softgel' && <ellipse cx="24" cy="24" rx="14" ry="10" class="fill" />}
      {form === 'gummy' && (
        <path d="M15 32 q-4 0 -4 -5 v-6 q0 -8 8 -8 h10 q8 0 8 8 v6 q0 5 -4 5 z" class="fill" />
      )}
      {form === 'melt-lozenge' && (
        <g>
          <ellipse cx="24" cy="24" rx="13" ry="7" class="fill" />
          <ellipse cx="24" cy="24" rx="7" ry="3" class="score-fill" />
        </g>
      )}
      {form === 'liquid-drops' && (
        <g>
          <rect x="14" y="23" width="14" height="15" rx="2.5" class="fill" />
          <rect x="18" y="17" width="6" height="6" class="fill" />
          <ellipse cx="21" cy="14" rx="5" ry="4" class="stroke-only" />
          <path d="M36 23 q3.5 4.5 0 6.5 q-3.5 -2 0 -6.5 z" class="fill" />
        </g>
      )}
      {form === 'spray' && (
        <g>
          <rect x="13" y="23" width="14" height="15" rx="2.5" class="fill" />
          <path d="M17 23 v-6 h8 v3.5" class="stroke-only" />
          <circle cx="32" cy="15" r="1.6" class="fill" />
          <circle cx="37" cy="12.5" r="1.2" class="fill" />
          <circle cx="37" cy="18" r="1.2" class="fill" />
        </g>
      )}
      {form === 'tea' && (
        <g>
          <rect x="14" y="22" width="17" height="17" rx="2.5" class="fill" />
          <path d="M22.5 22 v-6 h9" class="stroke-only" />
          <rect x="31" y="11" width="8" height="7" rx="1.5" class="stroke-only" />
        </g>
      )}
      {form === 'powder' && (
        <g>
          <path d="M14 23 h20 l-2 15 h-16 z" class="fill" />
          <rect x="12" y="17" width="24" height="6" rx="2" class="fill" />
          <path d="M20 30 h8" class="score" />
        </g>
      )}
      {form === 'patch' && (
        <g>
          <rect x="12" y="15" width="24" height="18" rx="4" class="fill" />
          <path d="M20 24 h8" class="score" />
        </g>
      )}
    </svg>
  )}

  {/* The brand letterform. It is the whole object when the form is unknown, and a quiet corner
      mark when a shape is drawn. */}
  <span class:list={['mark', form && 'corner']}>{initial}</span>
</span>

<style>
  /* raw-ok: --obj-size / --obj-radius are the component's generated geometry, set from props and
     consumed as tokens below; both DEFAULT to tokens at the call site. */
  .obj {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--obj-size);
    height: var(--obj-size);
    border-radius: var(--obj-radius);
    background: var(--surface-sunken);
    border: var(--border-w) solid var(--border-hairline);
    overflow: hidden;
    user-select: none;
  }
  .shape {
    display: block;
    width: 62%;
    height: 62%;
  }
  /* furniture, not data: the object uses the muted interface ink and no meaning colour */
  .fill {
    fill: var(--border-input);
  }
  .stroke-only {
    fill: none;
    stroke: var(--border-input);
    stroke-width: 2;
  }
  .score {
    stroke: var(--surface-sunken);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .score-fill {
    fill: var(--surface-sunken);
  }
  .mark {
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-weight: var(--weight-strong);
    line-height: 1;
    /* The letterform scales with the square (0.42 of it) — intentional off-scale geometry, like
       the badge/chip shapes the linter exempts. The 104px is the var's DEFAULT, not a type size.
       raw-ok: generated object geometry, not a type step */
    font-size: calc(var(--obj-size, 104px) * 0.42);
  }
  /* with a shape present the letter steps back to a corner mark */
  .corner {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 0 var(--space-2) var(--space-1) 0;
    color: var(--text-faint);
    /* raw-ok: corner mark scales with the object, same as above — not a type step */
    font-size: calc(var(--obj-size, 104px) * 0.17);
  }
</style>
