---
// BrandMark — the product image PLACEHOLDER as a first-class designed object, transcribed from
// the bundle kit (components/cards/BrandMark.jsx). Built at CHK-B6 (first use: the products
// list); CHK-B7 and CHK-B11 reuse it.
//
// RULES.md Products: "Placeholder imagery is the common case — a designed object (brand mark on
// sunken ground), never 'no photo' or broken-image." Most products will never have photography,
// so the placeholder is the DEFAULT path and has to look deliberate: the brand's initial, set in
// the one family, on the sunken ground inside a hairline. `src` is the exception, not the rule.
//
// The placeholder is aria-hidden: it carries no information the row's brand line doesn't already
// state, so announcing a bare letter would only add noise. A real photo is decorative too (the
// row's link text names the product), hence alt="".
interface Props {
  name: string;
  src?: string | null;
  /** Fixed pixel size. OMIT IT to let the caller drive the size responsively instead: the mark
   *  falls back to `--mark-size` inherited from its container (default 104px), which a parent
   *  can change in a media query. An inline custom property always beats a stylesheet rule, so
   *  a caller that needs two sizes must not pass this. */
  size?: number;
  radius?: string;
}
const { name, src = null, size, radius = 'var(--radius-md)' } = Astro.props;
const sizeVar = size ? `--mark-size:${size}px;` : '';
const initial = String(name).trim().charAt(0).toUpperCase() || '?';
---

{
  src ? (
    <img
      class="mark"
      src={src}
      alt=""
      width={size ?? 104}
      height={size ?? 104}
      style={`${sizeVar}--mark-radius:${radius}`}
    />
  ) : (
    <span
      class="mark placeholder"
      aria-hidden="true"
      style={`${sizeVar}--mark-radius:${radius}`}
    >
      {initial}
    </span>
  )
}

<style>
  /* raw-ok: --mark-size / --mark-radius are the component's generated geometry inputs, set from
     props and consumed as tokens below; the DEFAULTS come from tokens at the call site. */
  .mark {
    flex: none;
    width: var(--mark-size, 104px);
    height: var(--mark-size, 104px);
    border-radius: var(--mark-radius);
    border: var(--border-w) solid var(--border-hairline);
    background: var(--surface-sunken);
  }
  img.mark {
    object-fit: cover;
  }
  .placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-weight: var(--weight-strong);
    /* The letter scales with the square (0.45 of it) — intentional off-scale geometry, like the
       badge/chip shapes the linter exempts. The 104px inside the calc is the var's DEFAULT, not a
       type size: it only applies when neither a `size` prop nor a parent `--mark-size` is set.
       raw-ok: generated mark geometry, not a type step */
    font-size: calc(var(--mark-size, 104px) * 0.45);
    line-height: 1;
    user-select: none;
  }
</style>
