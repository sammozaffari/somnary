---
// StudyChip — "See the study" chip + popover, transcribed from the bundle kit
// (components/evidence/StudyChip.jsx). RULES.md Language: technical vocabulary (PMID/DOI) lives
// ONLY inside this popover, never in body copy. Built on a native <details> so it works with JS
// off and is keyboard-accessible for free (browse works without JS — CHK-B14 note). The popover
// gives the finding in one plain sentence, how many people, the year, a link out, and when
// Somnary last checked the link works.
interface Props {
  label?: string;
  finding: string;
  people?: number | null;
  year?: number | null;
  url?: string;
  linkText?: string;
  lastChecked?: string | null;
}
const {
  label = 'See the study',
  finding,
  people = null,
  year = null,
  url = '#',
  linkText = 'Read the study',
  lastChecked = null,
} = Astro.props;
---

<details class="chip">
  <summary>
    <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="3.5" fill="currentColor" opacity="0.8"></circle></svg>
    {label}
  </summary>
  <div class="pop" role="group" aria-label="Study details">
    <p class="finding">{finding}</p>
    {(people || year) && (
      <p class="meta">{people ? `${people.toLocaleString()} people` : ''}{people && year ? ' · ' : ''}{year ?? ''}</p>
    )}
    <a class="out" href={url} target="_blank" rel="noopener">{linkText} ↗</a>
    {lastChecked && <p class="checked">Link last checked {lastChecked}</p>}
  </div>
</details>

<style>
  .chip {
    position: relative;
    display: inline-block;
    font-family: var(--font-sans);
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    /* was --space-7 (32px) — a SPACING token standing in for a control height, the same slip
       B8's pending chip had. This is a standalone disclosure control, not a link inside a
       sentence, so the 44px hit floor applies with no exemption (RULES.md a11y). Measured at
       32px under CHK-B9's touch-target pass, on the chip's first use in the home hero. */
    min-height: var(--control-md);
    padding: var(--space-1) var(--space-3);
    border: var(--border-w) solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--text-link);
    font-weight: var(--weight-strong);
    font-size: var(--text-sm);
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
    transition: background var(--dur-fast) var(--ease-settle);
  }
  summary::-webkit-details-marker { display: none; }
  .chip[open] summary,
  summary:hover {
    background: var(--surface-sunken);
  }
  .pop {
    position: absolute;
    z-index: 30;
    top: calc(100% + var(--space-2));
    left: 0;
    width: var(--popover-w);
    background: var(--surface-card);
    border: var(--border-w) solid var(--border-hairline);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-pop);
    padding: var(--space-4);
  }
  .finding {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--leading-body);
    color: var(--text-body);
  }
  .meta {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }
  /* RULES.md a11y floor: a standalone "see the study" link, not a link inside a sentence, so
     the 44px hit floor applies with no inline exemption. Measured at 22px under CHK-B6's
     touch-target pass, floored here (ruled cross-scope fix, CHK-B7). Type size unchanged. */
  .out {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-md);
    margin-top: var(--space-3);
    font-weight: var(--weight-strong);
    font-size: var(--text-sm);
    color: var(--text-link);
  }
  .checked {
    margin: var(--space-3) 0 0;
    padding-top: var(--space-2);
    border-top: var(--border-w) solid var(--border-hairline);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--text-faint);
  }
</style>
