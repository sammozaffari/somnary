---
// Sticky top nav — DESIGN_SYSTEM §3 global chrome. Wordmark left; section links right.
// The ⌘K search trigger is intentionally deferred to CHK-4.2 (slot left below). Only links
// to pages that exist today are rendered, to avoid 404s; add more as routes land.
import Wordmark from './Wordmark.astro';
import SearchPalette from './SearchPalette.astro';
import SessionNav from './account/SessionNav.astro';

// Search-first IA (2026-07-27, Phase 1): the navbar collapses to two real destinations plus a
// first-class search affordance — Remedies (does it work?) + Which to buy (which product?) + Search.
// Everything else moves to the footer (Start here, Sleep habits, Compare, Safety, Label checker,
// Lens, Methodology) so the chrome stops overloading; all pages stay crawlable via footer + internal
// links. Lens becomes the search fallback engine (Phase 2), Label checker folds into search (Phase 3).
const links = [
  { href: '/tiers', label: 'Remedies' },
  { href: '/sources', label: 'Which to buy' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav class="nav" aria-label="Primary">
  <Wordmark />
  <ul class="links">
    {
      links.map((l) => {
        const current = path === l.href.replace(/\/$/, '');
        return (
          <li>
            <a href={l.href} aria-current={current ? 'page' : undefined} class:list={['link', { current }]}>
              {l.label}
            </a>
          </li>
        );
      })
    }
    <li><SearchPalette /></li>
    {/* Signed-in indicator (CHK-6.9c): hidden by default; revealed only for a real session.
        Adds NO sign-in CTA — no login wall in the global chrome. */}
    <SessionNav />
  </ul>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    height: 64px;
    padding: 0 var(--sp-7);
    /* §3: translucent paper + blur + hairline rule. */
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: var(--border-hairline);
  }
  .links {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Resting colour moved from --muted (too light, per owner 2026-07-27) to full --ink; the
     current/hover state is oxblood --primary so state stays legibly distinct. Tokens only. */
  .link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--ink);
    text-decoration: none;
    padding-bottom: 3px;
    /* the site's one signature interaction: an oxblood underline that draws in from the left */
    background: linear-gradient(var(--primary), var(--primary)) 0 100% / 0 1.5px no-repeat;
    transition:
      color var(--dur-fast) var(--ease-soft),
      background-size var(--dur-base) var(--ease-settle);
  }
  .link:hover {
    color: var(--primary);
    background-size: 100% 1.5px;
  }
  /* current page: a settled full underline (state, not motion) */
  .link.current {
    color: var(--primary);
    background-size: 100% 1.5px;
  }
  .link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--r-xs);
  }
  @media (max-width: 640px) {
    .nav {
      padding: 0 var(--sp-5);
    }
  }
</style>
