---
// Nav (app-shell header) — CHK-B2, transcribed from the bundle chrome (HomePage/RemediesPage
// headers). RULES.md Interface economy: the nav is EXACTLY three items — Remedies · Products ·
// Safety — plus ever-present search. Never re-add Problems / How-we-grade / tools to the chrome:
// Problems are reached by search + situation cards + cross-links; How-we-grade from every bucket
// badge and the footer. Interface colour is --ink (RULES.md Colour — no accent). Sentence case
// everywhere (RULES.md Identity). The three routes are greenfield (built at CHK-B5/B6/B10).
import Wordmark from './Wordmark.astro';
import SearchField from './SearchField.astro';

const links = [
  { href: '/remedies', label: 'Remedies' },
  { href: '/products', label: 'Products' },
  { href: '/safety', label: 'Safety' },
];
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="nav">
  <Wordmark />
  <nav class="links" aria-label="Primary">
    {
      links.map((l) => {
        const current = path === l.href || path.startsWith(l.href + '/');
        return (
          <a href={l.href} aria-current={current ? 'page' : undefined}>
            {l.label}
          </a>
        );
      })
    }
  </nav>
  <div class="nav-search">
    <SearchField size="sm" />
  </div>
</header>

<style>
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-4) var(--space-5);
  }
  /* the three links group; margin-left:auto right-aligns links+search on desktop and lets the
     search wrap to its own full-width row on a phone (390px nav overflow is a known risk) */
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-left: auto;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-md); /* 44px hit floor (RULES.md a11y) even though visually compact */
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-ui);
    transition:
      color var(--dur-fast) var(--ease-settle),
      background-color var(--dur-fast) var(--ease-settle);
  }
  .links a:hover {
    background: var(--surface-sunken);
    color: var(--text-body);
    text-decoration: none;
  }
  /* current page: ink text, no colour cue needed beyond weight + aria-current */
  .links a[aria-current='page'] {
    color: var(--text-body);
    font-weight: var(--weight-strong);
  }
  /* the ever-present search: on desktop it right-aligns after the links; when the header wraps
     (phone, and at the --page-max cap) it drops to its own row and fills it up to --search-max.
     The cap lives HERE (the container), not in SearchField, so there is no cross-component
     max-width conflict. */
  .nav-search {
    flex: 1 1 240px;
    min-width: 0;
    max-width: var(--search-max);
  }
</style>
