---
// Wordmark — the logotype "Somnary", capitalised, no trailing period, Onest 600.
// Transcribed from the bundle chrome (components/chrome/Wordmark.jsx). RULES.md Identity:
// the WORDMARK is the text "Somnary"; the letterform-S MARK is reserved for favicon / icon
// contexts (public/favicon*.svg, apple-touch, manifest — shipped at CHK-B1). The bundle nav
// is text-only, so B1's interim S-glyph-in-nav (which retired the crescent) is superseded here
// by the bundle-faithful text wordmark. Interface colour is --ink (RULES.md Colour — no accent).
interface Props {
  href?: string;
}
const { href = '/' } = Astro.props;
---

<a class="wordmark" href={href} aria-label="Somnary — home">Somnary</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-weight: var(--weight-strong); /* Onest 600 */
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-display);
    line-height: 1;
    color: var(--text-body);
    text-decoration: none;
  }
</style>
