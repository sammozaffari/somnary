---
// Presentational evidence-gate chip — DESIGN_SYSTEM §2.3. Takes a raw {label, variant}: used by
// VerdictBand (remedy frontmatter stores gates as label+variant pairs) and wrapped by
// EvidenceGateChip (which looks a gate up by id first). This is the single home for the §2.3
// variant→token map. Static (non-control) chip: no hover, label carries the meaning (never color).
import type { GateVariant } from '../lib/evidence-gates';

interface Props {
  label: string;
  variant: GateVariant;
  title?: string;
}
const { label, variant, title } = Astro.props;

// §2.3 variant → token pairs (the ONLY place these three pairs live).
const VARIANT_STYLE: Record<GateVariant, string> = {
  positive: 'color:var(--eucalyptus);background:var(--pistachio)',
  caution: 'color:var(--grade-c);background:var(--grade-c-tint)',
  neutral: 'color:var(--muted);background:var(--stone)',
};
---

<span class="gate-chip" style={VARIANT_STYLE[variant]} title={title}>{label}</span>

<style>
  .gate-chip {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: normal; /* chips are lowercase, not the uppercase --text-xs label style */
    text-transform: none;
    line-height: 1.25;
    /* §2.3 padding is a literal spec value (no token covers 5/11px). raw-ok: chip spec padding */
    padding: 5px 11px;
    border-radius: var(--r-md);
    /* Short chips stay on one line naturally; long caveat labels (e.g. "Human evidence is
       non-sleep …") must wrap rather than force the page wider than a phone. A pill radius on a
       two-line chip looks like a lozenge, so wrapping chips get the card radius. */
    max-width: 100%;
    overflow-wrap: break-word;
  }
</style>
