---
// Safety & interactions callout — the ONE canonical component (CMP-06 consolidation, 2026-07-30).
// Previously two components with the same name and divergent semantics existed
// (src/components/SafetyCallout.astro for remedy pages + src/components/scorecards/SafetyCallout.astro
// for product scorecards), so safety messaging could drift by product area. They are now one API.
//
// THREE registers (colour + sigil + severity word), never a grade colour for the hazard registers
// (guardrail: grades never imply safety):
//   • serious — vermilion safety register (warning-bg / vermilion / safety-ink). Documented harm /
//     F-grade, and the scorecard "safety" notes (they carry the same red safety family — mapping a
//     safety note DOWN to amber would understate it, so scorecard tone="safety" → register="serious").
//   • caution — amber advisory (grade-c family) for A/B-page cautions. White tag on --grade-c is
//     5.56:1 AA (C-01).
//   • info    — eucalyptus/pistachio informational register for non-hazard context (e.g. glycine's
//     food-vs-medicine framing, melatonin's prescription reality). No health hazard.
//
// TWO content modes, either or both may be supplied:
//   • risks[]  — rich remedy mode: category/text rows with citation markers, plus the folded-in
//     pregnancy and interactions rows so nothing about safety is buried.
//   • items[]  — simple scorecard mode: label/body pairs (body may contain <strong>/HTML).
//
// Small text is always dark (raisin/ink); the hue carries the signal via sigil/border/tag. The
// severity tag shows in rich (risks) mode by default — scorecard items mode leans on its own title —
// but `showTag` overrides either way. role="note". .row 160px 1fr → 1-col ≤640.
import CiteMarker from './CiteMarker.astro';

interface Risk {
  category: string;
  text: string;
  sources?: number[];
}
interface Item {
  label: string;
  body: string; // may contain inline HTML (<strong>, links)
}
interface Props {
  register: 'serious' | 'caution' | 'info';
  title?: string;
  lead?: string;
  risks?: Risk[];
  items?: Item[];
  pregnancy?: string;
  interactions?: string[];
  interactionsSources?: number[];
  foot?: string | null; // null hides the footer; undefined → default reference line
  showTag?: boolean;
}
const {
  register,
  title = 'Safety & interactions',
  lead,
  risks = [],
  items = [],
  pregnancy,
  interactions = [],
  interactionsSources = [],
  foot,
  showTag,
} = Astro.props;

const REGISTER = {
  serious: { word: 'Serious', glyph: '!' },
  caution: { word: 'Caution', glyph: '!' },
  info: { word: 'Info', glyph: 'i' },
} as const;
const reg = REGISTER[register];

// Rich (risks) mode shows the severity tag by default; items-only mode relies on its own title.
const withTag = showTag ?? risks.length > 0;
// undefined → the standard reference line; null → no footer.
const footText = foot === null ? null : (foot ?? 'Research reference · not medical advice');
---

<section class={`safety reg-${register}`} role="note" aria-label={title}>
  <div class="head">
    <span class="sigil" aria-hidden="true">{reg.glyph}</span>
    <p class="title">{title}</p>
    {withTag && <span class="sev-tag">{reg.word}</span>}
  </div>

  {lead && <p class="lead">{lead}</p>}

  <div class="rows">
    {
      risks.map((r) => (
        <div class="row">
          <p class="cat">{r.category}</p>
          <p class="text">
            {r.text}
            {(r.sources ?? []).map((n) => (
              <CiteMarker n={n} />
            ))}
          </p>
        </div>
      ))
    }
    {
      pregnancy && (
        <div class="row">
          <p class="cat">Pregnancy</p>
          <p class="text">{pregnancy}</p>
        </div>
      )
    }
    {
      interactions.length > 0 && (
        <div class="row">
          <p class="cat">Interactions</p>
          <div class="text">
            <ul class="int-list">
              {interactions.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
            {interactionsSources.length > 0 && (
              <span class="int-src">
                {interactionsSources.map((n) => (
                  <CiteMarker n={n} />
                ))}
              </span>
            )}
          </div>
        </div>
      )
    }
    {
      items.map((it) => (
        <div class="row">
          <p class="cat">{it.label}</p>
          <div class="text" set:html={it.body} />
        </div>
      ))
    }
  </div>

  {footText && <p class="foot">{footText}</p>}
</section>

<style>
  .safety {
    border-radius: var(--r-lg);
    border: 1px solid;
    padding: var(--sp-6);
  }
  /* Three registers. Small text = --raisin/--ink; hue lives in sigil/border/tag. */
  .reg-serious {
    background: var(--warning-bg);
    border-color: var(--vermilion);
  }
  .reg-serious .sigil {
    background: var(--vermilion);
  }
  .reg-serious .sev-tag {
    background: var(--safety-ink); /* white on safety-ink 6.5:1 (vermilion fails small) */
  }
  .reg-caution {
    background: var(--grade-c-tint);
    border-color: var(--grade-c);
  }
  .reg-caution .sigil {
    background: var(--grade-c);
  }
  .reg-caution .sev-tag {
    background: var(--grade-c); /* C-01: white on --grade-c is 5.56:1 (AA small, DESIGN §8) */
  }
  .reg-info {
    background: var(--pistachio);
    border-color: var(--eucalyptus);
  }
  .reg-info .sigil {
    background: var(--eucalyptus);
  }
  .reg-info .sev-tag {
    background: var(--eucalyptus); /* white on eucalyptus 6.16:1 (AA small, DESIGN §8) */
  }
  .title,
  .cat,
  .foot {
    color: var(--raisin);
  }

  .head {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .sigil {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: var(--r-pill);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--surface);
    line-height: 1;
  }
  .title {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    margin: 0;
    flex: 1;
  }
  .sev-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--surface);
    /* raw-ok: compact pill tag padding (4/10px off the 4px step by design) */
    padding: 4px 10px;
    border-radius: var(--r-pill);
  }

  .lead {
    font-size: var(--text-base);
    line-height: var(--lh-base);
    color: var(--ink);
    margin: var(--sp-5) 0 var(--sp-4);
  }

  .rows {
    display: flex;
    flex-direction: column;
  }
  .row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--sp-5);
    padding: var(--sp-4) 0;
    border-top: var(--border-hairline);
  }
  .cat {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    margin: 0;
  }
  .text {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: var(--ink);
    margin: 0;
  }
  .text :global(strong) {
    font-weight: 700;
  }
  .int-list {
    list-style: none;
    padding: 0;
  }
  .int-list li {
    padding-left: var(--sp-4);
    position: relative;
    margin-bottom: var(--sp-2);
  }
  .int-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--muted);
  }

  .foot {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    margin: var(--sp-5) 0 0;
    padding-top: var(--sp-4);
    border-top: var(--border-hairline);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
    }
  }
</style>
