---
import ReviewState from './ReviewState.astro';
import {
  EPISTEMIC_LABELS,
  FRESHNESS_LABELS,
  isArchival,
  type EpistemicState,
  type FreshnessState,
  type WorkflowState,
} from '../lib/remedy-state';

interface Props {
  workflowState: WorkflowState;
  epistemicState: EpistemicState;
  freshnessState: FreshnessState;
  statusReason?: string;
  reviewDueAt?: string;
  supersededBy?: string;
  validTo?: string;
}

const {
  workflowState,
  epistemicState,
  freshnessState,
  statusReason,
  reviewDueAt,
  supersededBy,
  validTo,
} = Astro.props;
const archival = isArchival({
  workflowState,
  epistemicState,
  freshnessState,
  statusReason,
  reviewDueAt,
  supersededBy,
  validTo,
});
const provisional = workflowState === 'pending_signoff' || workflowState === 'unreviewed';
const underReview = workflowState !== 'owner_ratified' && workflowState !== 'withdrawn';
---

<aside
  class:list={['publication-state', { 'is-provisional': provisional, 'is-archival': archival }]}
  aria-label="Publication status"
>
  <div class="state-head">
    <p class="eyebrow">Publication status</p>
    <h2 class="state-title">
      {archival ? 'Archived record' : provisional ? 'Provisional grade' : 'Evidence record'}
    </h2>
  </div>

  <dl class="axes">
    <div>
      <dt>Review</dt>
      <dd><ReviewState state={workflowState} detail /></dd>
    </div>
    <div>
      <dt>Evidence</dt>
      <dd>{EPISTEMIC_LABELS[epistemicState]}</dd>
    </div>
    <div>
      <dt>Freshness</dt>
      <dd>{FRESHNESS_LABELS[freshnessState]}</dd>
    </div>
  </dl>

  {underReview && (
    <p class="state-note">
      The grade remains visible for transparency but is excluded from default rankings until the
      author marks the review complete.
    </p>
  )}

  {statusReason && (
    <p class="state-note"><strong>Why this status:</strong> {statusReason}</p>
  )}

  {reviewDueAt && (
    <p class="state-note">
      <strong>Review due:</strong> <time datetime={reviewDueAt}>{reviewDueAt}</time>
    </p>
  )}

  {freshnessState === 'superseded' && supersededBy && (
    <p class="state-note">
      This page is retained as an archive. Read the current record:
      <a href={`/r/${supersededBy}`}>{supersededBy.replace(/-/g, ' ')} →</a>
    </p>
  )}

  {workflowState === 'withdrawn' && (
    <p class="state-note">
      This page is retained as a record and is not a current Somnary answer.
    </p>
  )}
</aside>

<style>
  .publication-state {
    margin-top: var(--sp-5);
    padding: var(--sp-6);
    background: var(--surface);
    border: var(--border-hairline);
    border-radius: var(--r-lg);
  }
  .publication-state.is-provisional {
    background: var(--primary-soft);
    border-color: var(--primary);
  }
  .publication-state.is-archival {
    background: var(--stone);
    border-color: var(--mineral);
  }
  .state-head {
    margin-bottom: var(--sp-4);
  }
  .eyebrow,
  dt {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
  }
  .state-title {
    margin: var(--sp-2) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--lh-lg);
    color: var(--ink);
  }
  .axes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
    margin: 0;
  }
  .axes > div {
    min-width: 0;
    padding-top: var(--sp-3);
    border-top: var(--border-hairline);
  }
  dd {
    margin: var(--sp-2) 0 0;
    color: var(--ink);
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
  }
  .state-note {
    max-width: 72ch;
    margin: var(--sp-4) 0 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
  }
  .state-note strong {
    color: var(--ink);
  }
  .state-note a {
    color: var(--primary);
    text-decoration: none;
  }
  .state-note a:hover,
  .state-note a:active {
    color: var(--primary-deep);
  }
  .state-note a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--r-xs);
  }
  @media (max-width: 640px) {
    .axes {
      grid-template-columns: 1fr;
    }
  }
</style>
