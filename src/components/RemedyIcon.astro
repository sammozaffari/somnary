---
// Decorative remedy illustration (retired presentation layer — the CHK-R1 charter drops
// illustration; this component is deleted at CHK-B18). Rendered as a CSS mask painted with
// `currentColor` (--ink), so the ink is a TOKEN at render time. The PNG supplies only the
// alpha silhouette. Unknown slugs fall back to the brand LETTERFORM-S mark on a sunken ground
// (RULES.md Identity + placeholder imagery) — the retired crescent-moon disc is gone (CHK-B1).
interface Props {
  slug: string;
  size?: 'chip' | 'inline' | 'card' | 'spot' | 'lead' | 'fill';
  class?: string;
}

const { slug, size = 'card', class: className } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/remedies/*.png', {
  eager: true,
});
const image = images[`../assets/remedies/${slug}.png`]?.default;
const classes = ['remedy-icon', `is-${size}`, className].filter(Boolean).join(' ');
---

{
  image ? (
    <span class={classes} style={`--icon:url("${image.src}")`} aria-hidden="true" />
  ) : (
    <span class={`${classes} is-fallback`} aria-hidden="true">
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <g transform="translate(5.58 27.25) scale(0.3177)">
          <path
            fill="currentColor"
            d="M34.2 0.8L34.2 0.8Q27.1 0.8 20.9-1.4Q14.6-3.5 10.4-8.3Q6.2-13 4.9-20.7L4.9-20.7L17.6-20.7Q18.8-16.8 21.5-14.6Q24.1-12.4 27.7-11.6Q31.3-10.7 35-10.7L35-10.7Q38.3-10.7 41.3-11.6Q44.2-12.4 46.2-14.4Q48.1-16.4 48.1-19.7L48.1-19.7Q48.1-22.2 47.1-23.8Q46-25.3 44.2-26.4Q42.3-27.4 39.7-28L39.7-28Q37.2-28.8 34.3-29.4Q31.4-30 28.6-30.7Q25.8-31.4 23.3-32.5L23.3-32.5Q20.1-33.6 17.2-35.1Q14.2-36.5 12.1-38.6Q9.9-40.7 8.6-43.8Q7.3-46.9 7.3-51.2L7.3-51.2Q7.3-56.1 9.0-59.7Q10.6-63.2 13.4-65.5Q16.1-67.8 19.6-69.1Q23-70.4 26.8-71Q30.5-71.6 33.9-71.6L33.9-71.6Q40.5-71.6 46.0-69.4Q51.4-67.2 54.9-62.6Q58.4-58 58.9-50.8L58.9-50.8L46.8-50.8Q46.4-54.2 44.4-56.3Q42.4-58.3 39.4-59.3Q36.4-60.2 32.9-60.2L32.9-60.2Q30.5-60.2 28.2-59.8Q25.8-59.4 24.0-58.4Q22.1-57.4 21.0-55.8Q19.8-54.1 19.8-51.6L19.8-51.6Q19.8-49.4 20.9-47.8Q22-46.1 24.0-45Q25.9-43.9 28.6-43L28.6-43Q32.1-41.6 36.3-40.9Q40.4-40.2 44.1-39L44.1-39Q47.7-38 50.8-36.6Q53.8-35.1 56-33.1Q58.2-31 59.5-28.1Q60.7-25.1 60.7-21L60.7-21Q60.7-15 58.6-10.9Q56.4-6.7 52.7-4.1Q48.9-1.5 44.2-0.4Q39.4 0.8 34.2 0.8Z"
          />
        </g>
      </svg>
    </span>
  )
}

<style>
  .remedy-icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    line-height: 1;
    color: var(--ink); /* interface ink — RULES.md Colour (retired --primary removed, CHK-B1) */
  }
  /* Masked illustration: the token paints the shape; the PNG supplies only the silhouette. */
  .remedy-icon:not(.is-fallback) {
    background-color: currentColor;
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }
  .is-chip {
    width: 20px;
    height: 20px;
  }
  .is-pill {
    width: 26px;
    height: 26px;
  }
  .is-inline {
    width: 32px;
    height: 32px;
  }
  .is-card {
    width: 48px;
    height: 48px;
  }
  .is-spot {
    width: 64px;
    height: 64px;
  }
  .is-lead {
    width: 120px;
    height: 120px;
  }
  /* fill: size to the parent box — used by the plate surfaces (RemedyCard), which size the
     art to their plate. */
  .is-fill {
    width: 100%;
    height: 100%;
  }
  /* placeholder mark — the letterform S in --ink on a sunken ground (RULES.md placeholder
     imagery: a designed object, never a broken image). Rounded square, not a disc. */
  .is-fallback {
    border-radius: var(--radius-sm);
    background: var(--surface-sunken);
    color: var(--ink);
  }
  .is-fallback svg {
    width: 62%;
    height: 62%;
  }
</style>
