---
/**
 * Label & Brands card — the top-of-page, first *actionable* block on a supplement
 * remedy page (docs/plans/2026-08-04-label-brand-card-design.md). It surfaces the two
 * things a reader needs before buying — what to look for on a label, and where to
 * compare brands — without inverting the "bottom line first" skeleton (it sits just
 * under the verdict/lead block, not above it).
 *
 * Content is reused from already-cited structured fields — it introduces NO new claims:
 *   - checklist  ← remedy.labelChecklist (✓ "look for" bullets)
 *   - avoid      ← remedy.labelAvoid (a single ⚠ "avoid" line — the corpus anti-hype beat)
 *   - fallback   ← remedy.standardization prose, shown when labelChecklist is empty so
 *                  the card is populated on every supplement page from day one.
 *
 * The brands row is HONEST-DEGRADING: it renders only when a ratified scorecard exists
 * (scorecardCount > 0). No dead links, no "#1", no recommendation — it links to the
 * comparison, mirroring the existing /sources CTA copy.
 *
 * Rendered for supplements only (interventions have no label); the caller gates on format.
 * Bullets allow <strong> via set:html, matching the scorecard LabelReadingPanel pattern.
 */
interface Props {
  checklist: string[];
  avoid: string[];
  standardization: string;
  scorecardHref: string | null;
  scorecardCount: number;
}
const { checklist, avoid, standardization, scorecardHref, scorecardCount } = Astro.props;

const hasChecklist = checklist.length > 0;
const hasAvoid = avoid.length > 0;
const showBrands = scorecardCount > 0 && scorecardHref !== null;
---

<section class="lbc" aria-labelledby="lbc-title">
  <h2 class="lbc-title" id="lbc-title">
    <span class="mark" aria-hidden="true">✓</span> On the label, look for
  </h2>

  {hasChecklist ? (
    <ul class="look">
      {checklist.map((item) => <li class="look-item" set:html={item} />)}
    </ul>
  ) : (
    <p class="look-prose">{standardization}</p>
  )}

  {hasAvoid && (
    <p class="avoid">
      <span class="avoid-mark" aria-hidden="true">⚠</span>
      <span class="avoid-label">Avoid:</span> <span set:html={avoid.join('; ')} />
    </p>
  )}

  <div class="links">
    <a class="link" href="#on-the-label">See the full label guide →</a>
    {showBrands && (
      <a class="link" href={scorecardHref}>
        Compare {scorecardCount} rated {scorecardCount === 1 ? 'brand' : 'brands'} →
      </a>
    )}
  </div>
</section>

<style>
  .lbc {
    padding: var(--sp-6);
    background: var(--surface);
    border: var(--border-hairline);
    border-radius: var(--r-lg);
  }

  .lbc-title {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-md);
    line-height: var(--lh-md);
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
    margin: 0;
  }
  /* positive accent for the "look for" mark, mirroring the scorecard LabelReadingPanel */
  .mark {
    color: var(--eucalyptus);
  }

  .look {
    list-style: none;
    margin: var(--sp-4) 0 0;
    padding: 0;
  }
  .look-item {
    position: relative;
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: var(--ink);
    padding: var(--sp-3) 0 var(--sp-3) var(--sp-5);
    border-bottom: var(--border-hairline);
  }
  .look-item:last-child {
    border-bottom: none;
  }
  /* ✓ per bullet, drawn in the positive accent, aligned to the first text line */
  .look-item::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--eucalyptus);
    font-weight: 700;
  }
  /* prose fallback when a remedy has no structured checklist yet */
  .look-prose {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: var(--ink);
    margin: var(--sp-4) 0 0;
    max-width: 68ch;
  }

  /* the single anti-hype "avoid" line — cautionary, NOT a serious-safety alarm: the
     vermilion mark carries the signal, but there is no red fill/background so it never
     cries wolf. Same semantic as the scorecard "what makes us cautious" column. */
  .avoid {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2);
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: var(--ink);
    margin: var(--sp-4) 0 0;
    padding-top: var(--sp-4);
    border-top: var(--border-hairline);
  }
  .avoid-mark {
    color: var(--safety-ink);
    font-weight: 700;
  }
  .avoid-label {
    font-weight: 700;
    color: var(--safety-ink);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-5);
    margin-top: var(--sp-5);
    padding-top: var(--sp-4);
    border-top: var(--border-hairline);
  }
  .link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
