---
// Evidence × Safety map — the /tiers overview (replaces the S–F leaderboard).
// Plots every remedy by two questions the single letter grade used to conflate:
//   X (columns, left→right) = strength of the published human evidence (from `tier`)
//   Y (rows, bottom→top)    = safety risk (from safety.severity + interaction load)
// Effect magnitude is NOT an axis — it stays in each remedy's own oneLineVerdict on
// the chip. Server-rendered (exists with JS off); the crawlable <ul> substrate lives
// in tiers.astro. DESIGN_SYSTEM discipline: grade tokens shade the EVIDENCE axis;
// the vermilion SAFETY register (never a grade color) marks serious-risk chips.
// Hierarchy = POSITION (the strong-evidence corner draws the eye); ratified vs
// under-review is TEXTURE only (solid vs dashed) — never a size/prominence gap.
import TierBadge from './TierBadge.astro';
import { getTier, type TierId } from '../lib/tiers';
import {
  EPISTEMIC_LABELS,
  gradeStampState,
  type EpistemicState,
  type WorkflowState,
} from '../lib/remedy-state';
import {
  EVIDENCE_BAND_LABELS,
  SAFETY_BAND_LABELS,
  SAFETY_INTERACTION_THRESHOLD,
} from '../lib/evidence-map';

export interface MapNode {
  slug: string;
  name: string;
  tier: TierId;
  workflowState: WorkflowState;
  oneLiner: string;
  epistemicState: EpistemicState;
  category: string;
  evidenceBand: number;
  safetyBand: number;
  ratified: boolean;
}
interface Props {
  nodes: MapNode[];
}
const { nodes } = Astro.props;

// Column tint = the representative grade of each evidence band (f→s, weak→strong):
// a warm-to-green field that reinforces the axis. Labels carry the meaning — never
// color alone. Safety is NOT in this palette (it rides the vermilion register).
const BAND_TINT: readonly TierId[] = ['F', 'D', 'C', 'B', 'S'];

// Rows top→bottom are riskiest→safest (y2, y1, y0); columns left→right weak→strong.
const ROWS = [2, 1, 0] as const;
const COLS = [0, 1, 2, 3, 4] as const;

function cellNodes(x: number, y: number): MapNode[] {
  return nodes
    .filter((n) => n.evidenceBand === x && n.safetyBand === y)
    .sort((a, b) => Number(b.ratified) - Number(a.ratified) || a.name.localeCompare(b.name));
}
---

<section class="evidence-map" aria-label="Remedies mapped by evidence strength and safety risk">
  <p class="sr-only">
    Remedies are plotted by evidence strength (weaker on the left, stronger on the right) and safety
    risk (more serious toward the top). A full alphabetical list follows below the map.
  </p>

  <p class="cap cap-y">↑ How risky is it? — more serious safety concerns toward the top</p>

  <div class="matrix" role="group" aria-label="Evidence by safety grid">
    {
      ROWS.map((y) => (
        <Fragment>
          <div class:list={['row-label', { 'is-serious': y === 2 }]} data-y={y}>
            {SAFETY_BAND_LABELS[y]}
          </div>
          {COLS.map((x) => {
            const lc = BAND_TINT[x].toLowerCase();
            const cell = cellNodes(x, y);
            return (
              <div
                class="cell"
                data-x={x}
                data-y={y}
                style={`--tint: var(--grade-${lc}-tint)`}
              >
                {cell.map((n) => {
                  const t = getTier(n.tier);
                  const state = gradeStampState(n.workflowState);
                  return (
                    <a
                      class:list={[
                        'chip',
                        n.ratified ? 'is-ratified' : 'is-review',
                        { 'is-serious': n.safetyBand === 2 },
                      ]}
                      href={`/r/${n.slug}`}
                      data-category={n.category}
                      aria-label={`${n.name} — grade ${n.tier}, ${t.name}; ${state.label}`}
                    >
                      <span class="chip-head">
                        <TierBadge tier={n.tier} size="inline" />
                        <span class="chip-name">{n.name}</span>
                      </span>
                      <span class="chip-verdict">{n.oneLiner}</span>
                      <span class="chip-meta">
                        <span class="chip-epistemic">{EPISTEMIC_LABELS[n.epistemicState]}</span>
                        <span class="chip-state">{state.label}</span>
                      </span>
                    </a>
                  );
                })}
              </div>
            );
          })}
        </Fragment>
      ))
    }
    <!-- axis-label row: empty corner + evidence-band captions -->
    <div class="corner" aria-hidden="true"></div>
    {COLS.map((x) => <div class="col-label" data-x={x}>{EVIDENCE_BAND_LABELS[x]}</div>)}
  </div>

  <p class="cap cap-x">→ How sure are we it works? — stronger published human evidence to the right</p>

  <div class="map-legend" aria-label="How to read the map">
    <span class="leg leg-review">Dashed = under author review</span>
    <span class="leg leg-ratified">Solid = review complete</span>
    <span class="leg leg-serious">Vermilion = serious safety concern</span>
    <span class="leg-note">
      Rows group safety by severity, then by interaction count ({SAFETY_INTERACTION_THRESHOLD}+ known
      interactions counts as “notable”). Position shows the evidence–safety trade-off; each card’s own
      line says how much it actually does.
    </span>
  </div>
</section>

<style>
  .evidence-map {
    margin: var(--sp-6) 0 var(--sp-8);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .cap {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    margin: 0;
  }
  .cap-y {
    margin-bottom: var(--sp-2);
  }
  .cap-x {
    margin-top: var(--sp-3);
    text-align: right;
  }

  /* the grid: a Y-label column + 5 evidence columns; 3 safety rows + an axis-label row */
  .matrix {
    display: grid;
    grid-template-columns: minmax(96px, auto) repeat(5, minmax(0, 1fr));
    gap: var(--sp-2);
    align-items: stretch;
  }

  .row-label {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    padding-right: var(--sp-2);
    text-align: right;
    justify-content: flex-end;
  }
  .row-label.is-serious {
    color: var(--safety-ink);
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-2);
    min-height: var(--sp-9);
    background: var(--tint);
    border-radius: var(--r-md);
    /* size to content and top-align: a near-empty cell in a tall row stays compact
       instead of stretching into a large empty tinted block */
    align-self: start;
  }

  .corner {
    /* aligns under the row-label column */
  }
  .col-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    padding-top: var(--sp-2);
    text-align: center;
  }

  /* node chip — same size regardless of review state (texture, not prominence) */
  .chip {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    text-decoration: none;
    color: var(--ink);
    transition:
      box-shadow var(--dur-base) var(--ease-settle),
      transform var(--dur-base) var(--ease-settle);
  }
  .chip:hover {
    box-shadow: var(--shadow-lift);
    transform: translateY(-2px);
  }
  .chip:focus-visible {
    outline: none;
    box-shadow: var(--ring);
  }
  /* review texture: solid (ratified) vs dashed (under review) — subtle, same footprint */
  .chip.is-ratified {
    border-style: solid;
    border-color: var(--mineral);
  }
  .chip.is-review {
    border-style: dashed;
  }
  /* safety register: serious-risk chips carry vermilion — DISTINCT from any grade color */
  .chip.is-serious {
    border-color: var(--vermilion);
    background: var(--warning-bg);
  }

  .chip-head {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .chip-name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    line-height: 1.15;
    color: var(--ink);
  }
  .chip-verdict {
    font-size: var(--text-xs);
    line-height: var(--lh-sm);
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .chip-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-2);
    margin-top: var(--sp-1);
  }
  .chip-epistemic,
  .chip-state {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
  }
  .chip.is-serious .chip-epistemic,
  .chip.is-serious .chip-state {
    color: var(--safety-ink);
  }

  .map-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2) var(--sp-5);
    margin-top: var(--sp-5);
    padding: var(--sp-3) var(--sp-4);
    background: var(--surface);
    border: var(--border-hairline);
    border-radius: var(--r-lg);
  }
  .leg {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--muted);
    padding-left: var(--sp-3);
    border-left: 3px solid var(--line);
  }
  .leg-ratified {
    border-left-style: solid;
    border-left-color: var(--mineral);
  }
  .leg-review {
    border-left-style: dashed;
    border-left-color: var(--muted);
  }
  .leg-serious {
    border-left-color: var(--vermilion);
    color: var(--safety-ink);
  }
  .leg-note {
    font-size: var(--text-sm);
    line-height: var(--lh-sm);
    color: var(--muted);
    flex-basis: 100%;
  }

  /* ≤640px: the 5-col matrix can't be a true grid. Collapse to a single column
     grouped by SAFETY band (the rows are already contiguous in source order):
     a "Serious caution / Notable interactions / General caution" heading, then its
     chips (each still carries its grade letter, so the evidence axis stays legible
     per-card). No horizontal overflow — the 360px responsive gate. */
  @media (max-width: 640px) {
    .cap-x {
      text-align: left;
    }
    .matrix {
      display: block;
    }
    .matrix > .corner,
    .matrix > .col-label {
      display: none;
    }
    .row-label {
      display: block;
      justify-content: flex-start;
      text-align: left;
      padding: var(--sp-5) 0 var(--sp-2);
      color: var(--ink);
      font-size: var(--text-sm);
    }
    .row-label.is-serious {
      color: var(--safety-ink);
    }
    .cell {
      background: transparent;
      padding: 0;
      min-height: 0;
      margin-bottom: var(--sp-2);
    }
    .cell:empty {
      display: none;
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chip {
      transition: none;
    }
    .chip:hover {
      transform: none;
    }
  }
</style>
